<script type="application/json" id="chapter-data" set:html={JSON.stringify({ discipline, chapters: lessons.map((lesson) => ({ slug: lesson.slug, shortcuts: lesson.shortcuts ?? (lesson.shortcut_keys ? [{ keys: lesson.shortcut_keys, label: lesson.shortcut_label }] : []), hasPractice: Boolean(lesson.practice_markdown), completed: completedLessons.has(lesson.slug), unlocked: unlockedLessons.has(lesson.slug) })) }).replace(/</g, '\\u003c')}></script>
<script>
  const pageData = JSON.parse(document.querySelector('#chapter-data')?.textContent ?? '{"discipline":"","chapters":[]}');
  const { discipline, chapters: chapterData } = pageData;
  const chapters = [...document.querySelectorAll<HTMLElement>('[data-chapter]')];
  const note = document.querySelector<HTMLTextAreaElement>('#lesson-note');
  const saveNoteButton = document.querySelector<HTMLButtonElement>('#save-note');
  const noteState = document.querySelector<HTMLElement>('#note-state');
  const activeTitle = document.querySelector<HTMLElement>('#active-chapter-title');
  const shortcutList = document.querySelector<HTMLElement>('#active-shortcuts');
  const notePanel = document.querySelector<HTMLElement>('#notes-panel');
  const shortcutsPanel = document.querySelector<HTMLElement>('#shortcuts-panel');
  const panelHint = document.querySelector<HTMLElement>('#reader-panel-hint');
  const practiceLink = document.querySelector<HTMLAnchorElement>('#practice-shortcut');
  const completeButton = document.querySelector<HTMLButtonElement>('#complete-chapter');
  const welcomeNav = document.querySelector<HTMLAnchorElement>('#welcome-nav');
  const welcomePage = document.querySelector<HTMLElement>('#bem-vindo');
  const chapterBySlug = new Map(chapterData.map((item) => [item.slug, item]));
  let activeSlug = '';
  let noteDirty = false;
  let loadCounter = 0;
  async function activateChapter(chapter: HTMLElement) {
    const slug = chapter.dataset.lesson ?? '';
    if (!slug || slug === activeSlug) return;
    const details = chapterBySlug.get(slug);
    if (!details?.unlocked) {
      alert('Conclua os capítulos anteriores para liberar este conteúdo.');
      return;
    }
    if (noteDirty && !confirm('Sua anotação ainda não foi salva. Descartar as alterações?')) return;
    noteDirty = false;
    history.replaceState(null, '', `#${slug}`);
    activeSlug = slug;
    if (welcomePage) welcomePage.hidden = true;
    // Cada módulo contém vários capítulos. O módulo deve ser mostrado uma
    // única vez para o capítulo selecionado, depois de ocultarmos os demais.
    document.querySelectorAll<HTMLElement>('.module-content').forEach((module) => { module.hidden = true; });
    chapters.forEach((item) => {
      const selected = item === chapter;
      item.hidden = !selected;
    });
    chapter.closest<HTMLElement>('.module-content')?.removeAttribute('hidden');
    if (notePanel) notePanel.hidden = false;
    if (shortcutsPanel) shortcutsPanel.hidden = false;
    if (panelHint) panelHint.hidden = true;
    welcomeNav?.classList.remove('selected-chapter-link');
    document.querySelectorAll<HTMLAnchorElement>('#chapter-nav a[href^="#"]').forEach((link) => {
      const selected = link.getAttribute('href') === `#${slug}`;
      link.classList.toggle('selected-chapter-link', selected);
      if (selected) link.setAttribute('aria-current', 'true'); else link.removeAttribute('aria-current');
    });
    if (activeTitle) activeTitle.textContent = chapter.dataset.title ?? 'Minhas notas';
    if (completeButton) {
      const completed = Boolean(details?.completed);
      completeButton.dataset.lesson = slug;
      completeButton.dataset.completed = String(completed);
      completeButton.disabled = completed;
      completeButton.classList.remove('hidden');
      completeButton.querySelector('span')!.textContent = completed ? '✓' : '○';
      completeButton.querySelectorAll('span')[1]!.textContent = completed ? 'Aula concluída' : 'Marcar como concluída';
    }
    if (shortcutList) {
      shortcutList.replaceChildren();
      if (details?.shortcuts.length) details.shortcuts.forEach((shortcut) => {
        const item = document.createElement('div'); item.className = 'mb-3 last:mb-0';
        const keys = document.createElement('kbd'); keys.className = 'rounded border border-border-light px-2 py-1 font-mono text-[10px] dark:border-border-dark'; keys.textContent = shortcut.keys;
        const label = document.createElement('p'); label.className = 'mt-2 font-semibold'; label.textContent = shortcut.label;
        item.append(keys, label); shortcutList.append(item);
      });
      else shortcutList.textContent = 'Nenhum atalho cadastrado para este capítulo.';
    }
    if (practiceLink) { practiceLink.href = `#${slug}-practice`; practiceLink.classList.toggle('hidden', !details?.hasPractice); practiceLink.classList.toggle('flex', Boolean(details?.hasPractice)); }
    if (!note) return;
    const requestId = ++loadCounter;
    note.disabled = true; note.value = ''; if (noteState) noteState.textContent = 'Carregando suas anotações…';
    try {
      const response = await fetch(`/api/notes?discipline=${encodeURIComponent(discipline)}&lesson=${encodeURIComponent(slug)}`);
      if (!response.ok) throw new Error('Entre para sincronizar suas anotações.');
      const result = await response.json();
      if (requestId !== loadCounter) return;
      note.value = result.note?.content ?? ''; note.disabled = false;
      noteDirty = false;
      if (saveNoteButton) saveNoteButton.disabled = true;
      if (noteState) noteState.textContent = note.value ? 'Anotação sincronizada.' : 'Suas anotações são privadas.';
    } catch (error) { if (noteState) noteState.textContent = error instanceof Error ? error.message : 'Não foi possível carregar as notas.'; }
  }
  chapters.forEach((chapter) => {
    const tabs = [...chapter.querySelectorAll<HTMLButtonElement>('[data-chapter-tab]')];
    const panels = [...chapter.querySelectorAll<HTMLElement>('[data-chapter-panel]')];
    tabs.forEach((tab) => tab.addEventListener('click', () => {
      const selected = tab.dataset.chapterTab;
      tabs.forEach((item) => {
        const isSelected = item === tab;
        item.setAttribute('aria-selected', String(isSelected));
        item.tabIndex = isSelected ? 0 : -1;
      });
      panels.forEach((panel) => { panel.hidden = panel.dataset.chapterPanel !== selected; });
    }));
    chapter.querySelector<HTMLButtonElement>('[data-download-chapter]')?.addEventListener('click', () => {
      const previousTitle = document.title;
      const panels = [...chapter.querySelectorAll<HTMLElement>('[data-chapter-panel]')];
      const originalPanelState = panels.map((panel) => ({ panel, wasHidden: panel.hidden, display: panel.style.display }));
      panels.forEach((panel) => { panel.hidden = false; panel.style.display = 'block'; });
      document.title = `${chapter.dataset.title ?? previousTitle} — Professor Deivid Nobre`;
      window.addEventListener('afterprint', () => {
        document.title = previousTitle;
        originalPanelState.forEach(({ panel, wasHidden, display }) => {
          panel.hidden = wasHidden;
          panel.style.display = display;
        });
      }, { once: true });
      window.print();
    });
  });
  practiceLink?.addEventListener('click', (event) => {
    const slug = activeSlug;
    const chapter = chapters.find((item) => item.dataset.lesson === slug);
    if (!chapter) return;
    event.preventDefault();
    chapter.querySelector<HTMLButtonElement>('[data-chapter-tab="practice"]')?.click();
    chapter.querySelector<HTMLElement>('[data-chapter-panel="practice"]')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
  document.querySelectorAll<HTMLAnchorElement>('[data-select-chapter][href^="#"]').forEach((link) => link.addEventListener('click', () => {
    const slug = link.getAttribute('href')?.slice(1);
    const chapter = chapters.find((item) => item.dataset.lesson === slug);
    if (chapter) activateChapter(chapter);
  }));
  document.querySelectorAll<HTMLAnchorElement>('[data-locked="true"]').forEach((link) => link.addEventListener('click', (event) => {
    event.preventDefault();
    alert('Conclua os capítulos anteriores para liberar este conteúdo.');
  }));
  welcomeNav?.addEventListener('click', () => {
    if (noteDirty && !confirm('Sua anotação ainda não foi salva. Descartar as alterações?')) return;
    noteDirty = false;
    activeSlug = '';
    loadCounter++;
    if (welcomePage) welcomePage.hidden = false;
    document.querySelectorAll<HTMLElement>('.module-content').forEach((module) => { module.hidden = true; });
    chapters.forEach((chapter) => { chapter.hidden = true; });
    if (notePanel) notePanel.hidden = true;
    if (shortcutsPanel) shortcutsPanel.hidden = true;
    if (practiceLink) practiceLink.classList.add('hidden');
    if (completeButton) completeButton.classList.add('hidden');
    if (completeButton) { completeButton.dataset.lesson = ''; completeButton.dataset.completed = 'false'; }
    if (panelHint) panelHint.hidden = false;
    welcomeNav.classList.add('selected-chapter-link');
    document.querySelectorAll<HTMLAnchorElement>('#chapter-nav a[href^="#"]').forEach((link) => { link.classList.remove('selected-chapter-link'); link.removeAttribute('aria-current'); });
  });
  chapters.forEach((chapter) => chapter.querySelector<HTMLElement>('[data-chapter-title]')?.addEventListener('click', () => activateChapter(chapter)));
  const hashChapter = chapters.find((chapter) => chapter.dataset.lesson === decodeURIComponent(location.hash.slice(1)));
  if (hashChapter) activateChapter(hashChapter);
  note?.addEventListener('input', () => {
    noteDirty = true;
    if (saveNoteButton) saveNoteButton.disabled = note.disabled;
    if (noteState) noteState.textContent = 'Alterações não salvas.';
  });
  saveNoteButton?.addEventListener('click', async () => {
    const slug = activeSlug;
    if (!slug || !note || note.disabled) return;
    saveNoteButton.disabled = true; saveNoteButton.querySelectorAll('span')[1].textContent = 'Salvando…';
    if (noteState) noteState.textContent = 'Salvando sua anotação…';
    try {
      const response = await fetch('/api/notes', { method: 'PUT', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ discipline_slug: discipline, lesson_slug: slug, content: note.value }) });
      if (!response.ok) throw new Error('Não foi possível salvar sua anotação.');
      noteDirty = false;
      if (slug === activeSlug && noteState) noteState.textContent = 'Anotação salva.';
    } catch (error) {
      if (slug === activeSlug && noteState) noteState.textContent = error instanceof Error ? error.message : 'Não foi possível salvar sua anotação.';
    } finally {
      saveNoteButton.querySelectorAll('span')[1].textContent = 'Salvar minhas notas';
      if (slug === activeSlug) saveNoteButton.disabled = !noteDirty;
    }
  });
  const filter = document.querySelector<HTMLInputElement>('#chapter-filter');
  filter?.addEventListener('input', () => {
    const value = filter.value.toLocaleLowerCase('pt-BR').trim();
    document.querySelectorAll<HTMLElement>('[data-search-item]').forEach((item) => { item.hidden = !item.dataset.searchText?.toLocaleLowerCase('pt-BR').includes(value); });
    document.querySelectorAll<HTMLDetailsElement>('.module-group').forEach((group) => { const hasMatch = [...group.querySelectorAll<HTMLElement>('[data-search-item]')].some((item) => !item.hidden); if (value && hasMatch) group.open = true; group.hidden = Boolean(value) && !hasMatch; });
  });
  completeButton?.addEventListener('click', async () => {
    if (!completeButton.dataset.lesson || completeButton.dataset.completed === 'true') return;
    completeButton.disabled = true;
    try {
      const response = await fetch('/api/progress', { method: 'PUT', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ discipline_slug: completeButton.dataset.discipline, lesson_slug: completeButton.dataset.lesson, completed: true }) });
      const result = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(result.error ?? 'Não foi possível salvar seu progresso.');
      completeButton.dataset.completed = 'true';
      completeButton.querySelector('span')!.textContent = '✓';
      completeButton.querySelectorAll('span')[1]!.textContent = 'Aula concluída';
      const chapter = chapters.find((item) => item.dataset.lesson === completeButton.dataset.lesson);
      if (chapter) { const details = chapterBySlug.get(completeButton.dataset.lesson); if (details) details.completed = true; }
      // Recarrega os vínculos de progresso no servidor; assim o próximo capítulo
      // só recebe conteúdo depois que a conclusão anterior foi persistida.
      location.reload();
    } catch (error) {
      alert(error instanceof Error ? error.message : 'Não foi possível salvar o progresso.');
      completeButton.disabled = false;
    }
  });
</script>

