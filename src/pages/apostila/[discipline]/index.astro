---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { createSupabaseServerClient } from '../../../lib/supabase';
import { disciplines } from '../../../lib/catalog';
import { marked } from 'marked';
import sanitizeHtml from 'sanitize-html';
import { fruitEmojis } from '../../../lib/fruit-emojis';
export const prerender = false;
const { discipline } = Astro.params;
let user = null;
let subject: any = disciplines.find((item) => item.slug === discipline) ?? null;
let modules: any[] = [];
let lessons: any[] = [];
let completedLessons = new Set<string>();
let isAdmin = false;
let studentYear: number | null = null;
let unlockedByKeyword = new Set<string>();
try {
  const supabase = createSupabaseServerClient(Astro.cookies, Astro.request);
  const { data: auth } = await supabase.auth.getUser(); user = auth.user;
  const [d, m, l, p, profile] = await Promise.all([
    supabase.from('disciplines').select('*').eq('slug', discipline).eq('active', true).maybeSingle(),
    supabase.from('modules').select('*').eq('discipline_slug', discipline).order('sort_order'),
    supabase.from('apostilas').select('*').eq('discipline_slug', discipline).eq('published', true).order('lesson_order'),
    user ? supabase.from('lesson_progress').select('lesson_slug').eq('user_id', user.id).eq('disciplina_slug', discipline) : Promise.resolve({ data: [] }),
    user ? supabase.from('profiles').select('role,year_level').eq('id', user.id).maybeSingle() : Promise.resolve({ data: null })
  ]);
  if (d.data) subject = d.data;
  modules = m.data ?? [];
  lessons = l.data ?? [];
  completedLessons = new Set((p.data ?? []).map((row: any) => row.lesson_slug));
  isAdmin = profile.data?.role === 'admin';
  studentYear = Number(profile.data?.year_level) || null;
  if (user) {
    const { data: unlocks } = await supabase.from('lesson_unlocks').select('lesson_slug').eq('user_id', user.id).eq('discipline_slug', discipline);
    unlockedByKeyword = new Set((unlocks ?? []).map((row: any) => row.lesson_slug));
  }
} catch { /* A navegação permanece acessível e informa quando não há conteúdo publicado. */ }
if (!subject) return Astro.redirect('/');
const moduleOrder = (lesson: any) => {
  const index = modules.findIndex((module) => module.id === lesson.module_id || module.name === lesson.module);
  return index < 0 ? modules.length : index;
};
const lessonsByOrder = [...lessons].sort((a, b) => moduleOrder(a) - moduleOrder(b) || a.lesson_order - b.lesson_order || a.title.localeCompare(b.title, 'pt-BR'));
const lessonNavigation = new Map(lessonsByOrder.map((lesson, index) => [lesson.slug, {
  previous: lessonsByOrder[index - 1] ?? null,
  next: lessonsByOrder[index + 1] ?? null,
}]));
const unlockedLessons = new Set<string>();
const sequenceAvailableLessons = new Set<string>();
const keywordPromptLessons = new Set<string>();
let reachedFirstIncomplete = false;
for (const lesson of lessonsByOrder) {
  const sequenceAvailable = isAdmin || !reachedFirstIncomplete;
  const olderYearAccess = Boolean(studentYear && subject.year_level && studentYear > Number(subject.year_level));
  if (sequenceAvailable) sequenceAvailableLessons.add(lesson.slug);
  if (sequenceAvailable && (isAdmin || olderYearAccess || !lesson.keyword_required || unlockedByKeyword.has(lesson.slug))) unlockedLessons.add(lesson.slug);
  else if (sequenceAvailable && lesson.keyword_required && !isAdmin && !olderYearAccess) keywordPromptLessons.add(lesson.slug);
  if (!completedLessons.has(lesson.slug)) reachedFirstIncomplete = true;
}
const chapterModules = modules.map((module) => ({ ...module, lessons: lessons.filter((lesson) => lesson.module_id === module.id || lesson.module === module.name) }));
const withoutModule = lessons.filter((lesson) => !lesson.module_id && !modules.some((module) => module.name === lesson.module));
const renderMarkdown = async (markdown: string) => sanitizeHtml(await marked.parse(markdown ?? ''));
const shortcutsFromPractice = (markdown: string): { keys: string; label: string }[] => {
  const found = new Map<string, string>();
  const patterns = [
    /\b(?:Ctrl|Alt|Shift|Cmd|Command)(?:\s*\+\s*(?:Ctrl|Alt|Shift|Cmd|Command))*\s*\+\s*[A-Za-zÀ-ÿ0-9]+(?:\s*\+\s*[A-Za-zÀ-ÿ0-9]+)*/gi,
    /\bF(?:[1-9]|1[0-2])\b/gi,
    /\b(?:tecla|atalho)\s+([A-Z])\b/gi,
    /\bBarra de Espaço\b/gi,
  ];
  for (const line of markdown.split(/\r?\n/)) for (const pattern of patterns) {
    pattern.lastIndex = 0;
    for (const match of line.matchAll(pattern)) {
      const keys = (match[1] && /tecla|atalho/i.test(match[0]) ? match[1] : match[0]).replace(/\s*\+\s*/g, ' + ').trim();
      const key = keys.toLocaleLowerCase('pt-BR');
      if (found.has(key)) continue;
      const prefix = line.slice(0, match.index ?? 0);
      const tool = [...prefix.matchAll(/\b(?:Ferramenta|Painel)\s+[^(),.;]+/gi)].at(-1)?.[0]?.trim();
      const rest = line.slice((match.index ?? 0) + match[0].length).replace(/[*_`]/g, '').trim();
      const annotation = rest.match(/^\s*\(([^)]+)\)/)?.[1]?.trim();
      const action = rest.replace(/^\s*[):,;—–-]+\s*/, '').replace(/^para\s+/i, '').split(/[.!?,;\n]/, 1)[0]?.trim();
      const label = tool ?? annotation ?? action;
      found.set(key, label ? label.slice(0, 120) : 'Usado na prática guiada');
    }
  }
  return [...found].slice(0, 12).map(([keys, label]) => ({ keys, label }));
};
for (const lesson of lessons) {
  lesson.body_html = await renderMarkdown(lesson.body_markdown);
  lesson.practice_html = await renderMarkdown(lesson.practice_markdown);
  if (!lesson.shortcuts?.length && !lesson.shortcut_keys && lesson.practice_markdown) lesson.shortcuts = shortcutsFromPractice(lesson.practice_markdown);
}
for (const module of chapterModules) module.lessons = lessons.filter((lesson) => lesson.module_id === module.id || lesson.module === module.name);
for (let i = 0; i < withoutModule.length; i++) {
  withoutModule[i].body_html = lessons.find((lesson) => lesson.slug === withoutModule[i].slug)?.body_html ?? '';
  withoutModule[i].practice_html = lessons.find((lesson) => lesson.slug === withoutModule[i].slug)?.practice_html ?? '';
}
const chapterCount = lessons.length;
const totalMinutes = lessons.reduce((sum, lesson) => sum + (lesson.reading_minutes ?? 10), 0);
const formatChapterDate = (value: string | null | undefined) => value ? new Intl.DateTimeFormat('pt-BR', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'America/Sao_Paulo' }).format(new Date(value)) : null;
const chapterAccessNotice = Astro.url.searchParams.has('capitulo-bloqueado');
---
<BaseLayout title={`${subject.name} — Professor Deivid Nobre - Apostilas`} description={subject.description} user={user}>
  <div class="reader-shell">
    <aside class="reader-left"><div class="reader-left-inner">
      <div class="mb-5"><p class="text-[10px] font-bold uppercase tracking-[.18em] text-text-muted-light dark:text-text-muted-dark">Seu percurso</p><div class="mt-3 h-1.5 overflow-hidden rounded-full bg-black/10 dark:bg-white/10"><div class="h-full rounded-full bg-accent-light" style={`width:${chapterCount ? Math.round(completedLessons.size / chapterCount * 100) : 0}%`}></div></div><p class="mt-2 text-[10px] text-text-muted-light dark:text-text-muted-dark">{chapterCount ? Math.round(completedLessons.size / chapterCount * 100) : 0}% concluído</p></div>
      <label class="desktop-chapter-search relative block"><span class="sr-only">Encontrar capítulo neste módulo</span><span aria-hidden="true" class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-text-muted-light">⌕</span><input id="chapter-filter" class="w-full rounded-lg border border-border-light bg-surface-light py-2 pl-9 pr-3 text-xs outline-none focus:border-accent-light dark:border-border-dark dark:bg-surface-dark" placeholder="Encontrar capítulo" /></label>
      <div class="mobile-chapter-search"><button id="mobile-chapter-search-toggle" type="button" aria-expanded="false" aria-controls="mobile-chapter-search-panel"><span aria-hidden="true">⌕</span><span>Buscar capítulo</span><span aria-hidden="true" class="mobile-search-chevron">⌄</span></button><section id="mobile-chapter-search-panel" class="mobile-search-panel" hidden aria-label="Buscar capítulo"><div class="mobile-search-input-row"><label for="mobile-chapter-filter" class="sr-only">Digite o nome do capítulo</label><input id="mobile-chapter-filter" type="search" enterkeyhint="search" autocomplete="off" spellcheck="false" placeholder="Digite o nome do capítulo" /><button id="mobile-chapter-search-close" type="button" aria-label="Fechar busca">×</button></div><p class="mobile-search-caption">Capítulos da disciplina</p><div id="mobile-chapter-search-results" class="mobile-search-results">{lessonsByOrder.map((lesson: any) => { const unlocked = unlockedLessons.has(lesson.slug); const sequenceAvailable = sequenceAvailableLessons.has(lesson.slug); const keywordPrompt = keywordPromptLessons.has(lesson.slug); const moduleName = lesson.module || modules.find((item) => item.id === lesson.module_id)?.name || 'Capítulos'; return <button type="button" data-mobile-search-item data-title={`${lesson.title} ${moduleName} ${(lesson.tags ?? []).join(' ')}`} data-slug={lesson.slug} data-unlocked={unlocked} data-sequence-available={sequenceAvailable} disabled={!sequenceAvailable}><span class="mobile-search-result-copy"><strong>{lesson.title}</strong><small>{moduleName}</small></span><span aria-hidden="true">{completedLessons.has(lesson.slug) ? '✓' : unlocked ? '↗' : '🔒'}</span></button>; })}<p id="mobile-chapter-search-empty" hidden>Nenhum capítulo encontrado.</p></div></section></div>
      <nav id="chapter-nav" class="mt-5 space-y-4" aria-label="Módulos e capítulos">
        <a id="welcome-nav" href="#bem-vindo" class="welcome-nav-link"><span class="welcome-nav-icon">✳</span><span><strong>Bem-vindo</strong><small>Sobre esta disciplina</small></span></a>
        {chapterModules.map((module, index) => <details class="module-group"><summary class="flex cursor-pointer list-none items-start gap-2 border-b border-border-light pb-3 dark:border-border-dark"><span class="font-display text-lg text-accent-light">{String(index + 1).padStart(2, '0')}</span><span class="min-w-0 flex-1"><strong class="block text-xs">{module.name}</strong><small class="text-[10px] text-text-muted-light dark:text-text-muted-dark">{module.lessons.length} capítulos</small></span><span aria-hidden="true" class="text-text-muted-light">⌄</span></summary><ul class="ml-3 mt-2 space-y-1 border-l border-border-light pl-2 dark:border-border-dark">{module.lessons.map((lesson: any) => { const unlocked = unlockedLessons.has(lesson.slug); const sequenceAvailable = sequenceAvailableLessons.has(lesson.slug); const keywordPrompt = keywordPromptLessons.has(lesson.slug); return <li data-search-item data-search-text={`${lesson.title} ${module.name} ${(lesson.tags ?? []).join(' ')}`}><a data-select-chapter={sequenceAvailable ? '' : undefined} data-keyword-prompt={keywordPrompt ? 'true' : undefined} data-locked={!sequenceAvailable ? 'true' : undefined} aria-disabled={!sequenceAvailable ? 'true' : undefined} class:list={["flex items-start gap-2 rounded-md px-2 py-2 text-[11px] leading-snug text-text-muted-light hover:bg-black/5 hover:text-accent-light dark:text-text-muted-dark dark:hover:bg-white/5", { 'chapter-locked': !unlocked }]} href={`#${lesson.slug}`}><span class="w-4 shrink-0 font-mono text-[9px]">{completedLessons.has(lesson.slug) ? '✓' : unlocked ? String(lesson.lesson_order + 1).padStart(2, '0') : '🔒'}</span><span>{lesson.title}</span></a></li>; })}</ul></details>)}
        {withoutModule.length > 0 && <details class="module-group"><summary class="flex cursor-pointer list-none items-start gap-2 border-b border-border-light pb-3 dark:border-border-dark"><span class="font-display text-lg text-accent-light">{String(chapterModules.length + 1).padStart(2, '0')}</span><span class="min-w-0 flex-1"><strong class="block text-xs">Capítulos</strong><small class="text-[10px] text-text-muted-light dark:text-text-muted-dark">{withoutModule.length} capítulos</small></span></summary><ul class="ml-3 mt-2 space-y-1 border-l border-border-light pl-2 dark:border-border-dark">{withoutModule.map((lesson: any) => { const unlocked = unlockedLessons.has(lesson.slug); const sequenceAvailable = sequenceAvailableLessons.has(lesson.slug); const keywordPrompt = keywordPromptLessons.has(lesson.slug); return <li data-search-item data-search-text={`${lesson.title} ${(lesson.tags ?? []).join(' ')}`}><a data-select-chapter={sequenceAvailable ? '' : undefined} data-keyword-prompt={keywordPrompt ? 'true' : undefined} data-locked={!sequenceAvailable ? 'true' : undefined} aria-disabled={!sequenceAvailable ? 'true' : undefined} class:list={["flex gap-2 rounded-md px-2 py-2 text-[11px] text-text-muted-light hover:text-accent-light dark:text-text-muted-dark", { 'chapter-locked': !unlocked }]} href={`#${lesson.slug}`}><span class="font-mono text-[9px]">{unlocked ? String(lesson.lesson_order + 1).padStart(2, '0') : '🔒'}</span>{lesson.title}</a></li>; })}</ul></details>}
      </nav>
      <blockquote class="mt-7 rounded-xl bg-[#14231e] p-4 text-white"><span class="text-highlight-light">✳</span><p class="mt-2 font-display text-sm leading-relaxed">“Aprenda um capítulo de cada vez. Cada ideia abre caminho para a próxima.”</p><cite class="mt-2 block text-[9px] text-white/60">Seu percurso de aprendizagem</cite></blockquote>
    </div></aside>

    <main class="reader-main">
      {chapterAccessNotice && <p role="status" class="mb-5 rounded-xl border border-highlight-light/50 bg-highlight-light/20 px-4 py-3 text-sm leading-relaxed dark:border-highlight-dark/50 dark:bg-highlight-dark/10">Conclua os capítulos na ordem para liberar os próximos conteúdos.</p>}
      <section id="bem-vindo" class="welcome-page scroll-mt-24" aria-label={`Bem-vindo à disciplina ${subject.name}`}>
      <header class="discipline-hero"><div class="welcome-label"><span class="welcome-icon">✳</span><span><small>APOSTILA DIGITAL</small><strong>Bem-vindo à disciplina</strong></span></div><h1 class="mt-4 font-display text-5xl font-semibold leading-[1.05] tracking-tight md:text-6xl">{subject.name}</h1><div class="mt-7 flex flex-wrap gap-4 text-[10px] font-semibold uppercase tracking-widest text-text-muted-light dark:text-text-muted-dark"><span><strong class="text-accent-light">{String(chapterCount).padStart(2, '0')}</strong> capítulos</span><span>{totalMinutes} min de leitura</span><span>Material de estudo</span></div></header>
      <section class="learning-outcomes" aria-label="Sobre a disciplina">
        <article class="outcome-card description-card"><p class="text-[10px] font-bold uppercase tracking-[.18em] text-accent-light">Conheça a disciplina</p><h2 class="mt-2 font-display text-xl font-semibold">Descrição</h2><p class="mt-4 text-sm leading-relaxed text-text-muted-light dark:text-text-muted-dark">{subject.description || 'A apresentação desta disciplina será adicionada pelo professor.'}</p></article>
        <article class="outcome-card"><p class="text-[10px] font-bold uppercase tracking-[.18em] text-accent-light">Na prática</p><h2 class="mt-2 font-display text-xl font-semibold">Habilidades</h2>{subject.skills?.length ? <ul class="mt-4 space-y-2">{subject.skills.map((skill: string) => <li class="flex gap-2 text-sm leading-relaxed"><span class="text-accent-light">↗</span><span>{skill}</span></li>)}</ul> : <p class="mt-4 text-sm leading-relaxed text-text-muted-light dark:text-text-muted-dark">As habilidades serão adicionadas pelo professor.</p>}</article>
        <article class="outcome-card outcome-card-dark"><p class="text-[10px] font-bold uppercase tracking-[.18em] text-highlight-light">Ao final</p><h2 class="mt-2 font-display text-xl font-semibold">Competências</h2>{subject.competencies?.length ? <ul class="mt-4 space-y-2">{subject.competencies.map((competency: string) => <li class="flex gap-2 text-sm leading-relaxed"><span class="text-highlight-light">✳</span><span>{competency}</span></li>)}</ul> : <p class="mt-4 text-sm leading-relaxed text-white/70">As competências serão adicionadas pelo professor.</p>}</article>
      </section>
      {chapterCount > 0 && <aside class="chapter-sequence-note" role="note"><span aria-hidden="true">ⓘ</span><p><strong>Avance capítulo por capítulo.</strong> O bem-vindo é apenas uma apresentação. Conclua cada capítulo para liberar o próximo; alguns também pedem uma palavra-chave do professor.</p></aside>}
      {chapterModules.length > 0 && <section class="module-picker" aria-label="Escolha um módulo e capítulo"><div class="flex flex-wrap items-end justify-between gap-3"><div><p class="text-[10px] font-bold uppercase tracking-[.18em] text-accent-light">Por onde começar</p><h2 class="mt-1 font-display text-2xl font-semibold">Escolha um módulo</h2></div><p class="text-xs text-text-muted-light dark:text-text-muted-dark">Abra um módulo para ver seus capítulos.</p></div><div class="mt-4 grid gap-2">{chapterModules.map((module, index) => <details class="module-choice"><summary><span class="module-choice-number">{String(index + 1).padStart(2, '0')}</span><span class="min-w-0 flex-1"><strong>{module.name}</strong><small>{module.lessons.length} capítulos</small></span><span class="module-choice-chevron" aria-hidden="true">⌄</span></summary><div class="module-choice-lessons">{module.lessons.length ? module.lessons.map((lesson: any) => { const unlocked = unlockedLessons.has(lesson.slug); const sequenceAvailable = sequenceAvailableLessons.has(lesson.slug); const keywordPrompt = keywordPromptLessons.has(lesson.slug); return <a data-select-chapter={sequenceAvailable ? '' : undefined} data-keyword-prompt={keywordPrompt ? 'true' : undefined} data-locked={!sequenceAvailable ? 'true' : undefined} aria-disabled={!sequenceAvailable ? 'true' : undefined} class:list={[{ 'chapter-locked': !unlocked }]} href={`#${lesson.slug}`}><span>{unlocked ? String(lesson.lesson_order + 1).padStart(2, '0') : '🔒'}</span><strong>{lesson.title}</strong><span aria-hidden="true">↗</span></a>; }) : <p class="p-4 text-sm text-text-muted-light dark:text-text-muted-dark">Os capítulos deste módulo serão publicados em breve.</p>}</div></details>)}</div></section>}
      </section>
      {chapterModules.map((module, moduleIndex) => <section class="module-content" aria-label={module.name} hidden><div class="module-heading"><span class="text-xs font-bold uppercase tracking-widest text-accent-light">Módulo {String(moduleIndex + 1).padStart(2, '0')}</span><span class="mx-2 h-px w-8 bg-border-light dark:bg-border-dark"></span><span class="text-xs font-bold uppercase tracking-widest">{module.name.replace(/^m[oó]dulo\s+[^:]+:\s*/i, '')}</span></div>
        {module.lessons.map((lesson: any) => { const unlocked = unlockedLessons.has(lesson.slug); const navigation = lessonNavigation.get(lesson.slug); const previousLesson = navigation?.previous; const nextLesson = navigation?.next; return <article id={lesson.slug} data-chapter data-lesson={lesson.slug} data-title={lesson.title} data-unlocked={unlocked} class="chapter-article scroll-mt-24" hidden>
          {!unlocked ? keywordPromptLessons.has(lesson.slug) ? <><div class="chapter-title-row"><span>🔑</span><h2 class="font-display text-2xl font-semibold leading-tight">Este capítulo precisa de uma palavra-chave</h2></div><p class="mt-3 text-sm text-text-muted-light dark:text-text-muted-dark">Peça a sequência de frutas ao professor para liberar este capítulo. Depois de liberado, ele continuará disponível na sua conta.</p><form data-unlock-form data-discipline={discipline} data-lesson={lesson.slug} class="keyword-unlock-form"><fieldset class="fruit-access-fieldset"><legend>Selecione os quatro emojis na ordem informada pelo professor</legend><div class="fruit-sequence-slots" aria-label="Sequência escolhida">{[0, 1, 2, 3].map((position) => <button type="button" class="fruit-sequence-slot" data-fruit-slot={position} aria-label={`Fruta ${position + 1}: não selecionada`}>＋</button>)}</div><div class="fruit-choice-grid" aria-label="Escolha uma fruta para a próxima posição">{fruitEmojis.map((fruit) => <button type="button" class="fruit-choice" data-fruit-choice={fruit.emoji} data-fruit-name={fruit.name} aria-label={fruit.name} title={fruit.name}>{fruit.emoji}</button>)}</div><div class="fruit-sequence-actions"><button type="button" data-fruit-undo class="fruit-secondary-action">Desfazer última</button><button type="button" data-fruit-clear class="fruit-secondary-action">Limpar sequência</button></div><details class="fruit-access-alternative"><summary>Alternativa acessível: escolher pelo nome das frutas</summary><p>Escolha uma fruta para cada posição da sequência. Os nomes são anunciados por leitores de tela.</p><div class="fruit-name-selects">{[0, 1, 2, 3].map((position) => <label>Fruta {position + 1}<select data-fruit-select={position} aria-label={`Escolha a fruta da posição ${position + 1}`}><option value="">Selecione uma fruta</option>{fruitEmojis.map((fruit) => <option value={fruit.emoji}>{fruit.name}</option>)}</select></label>)}</div></details><input type="hidden" name="keyword" /><p data-fruit-selection-status class="fruit-selection-status" aria-live="polite">Nenhuma fruta selecionada.</p></fieldset><button type="submit" class="keyword-unlock-button" disabled><span aria-hidden="true">🔓</span> Liberar capítulo</button><p data-unlock-status class="keyword-unlock-status" aria-live="polite"></p></form></> : <><div class="chapter-title-row"><span>🔒</span><h2 class="font-display text-xl font-semibold leading-tight">Capítulo bloqueado</h2></div><div class="chapter-locked-message"><strong>Conclua os capítulos anteriores para liberar este conteúdo.</strong><p class="mt-2 text-sm">Seu progresso fica salvo automaticamente quando você marca uma aula como concluída.</p></div></> : <>
          {previousLesson && <a data-select-chapter href={`#${previousLesson.slug}`} class="previous-chapter"><span aria-hidden="true">←</span><span><small>Capítulo anterior</small><strong>{previousLesson.title}</strong></span></a>}
          {isAdmin && <div class="reader-edit-actions"><button type="button" class="reader-edit-chapter" data-edit-reader-chapter={lesson.slug} aria-label="Editar capítulo" title="Editar capítulo"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L8 18l-4 1 1-4Z"/></svg></button></div>}
          <div class="chapter-title-row"><span>{String(lesson.lesson_order + 1).padStart(2, '0')}</span><h2 data-chapter-title class="font-display text-3xl font-semibold leading-tight">{lesson.title}</h2></div>
          {lesson.summary && <p class="mb-6 ml-12 text-sm leading-relaxed text-text-muted-light dark:text-text-muted-dark">{lesson.summary}</p>}
          <div class="chapter-meta mt-3 mb-5 ml-12"><span aria-label={`Tempo estimado de leitura: ${lesson.reading_minutes ?? 10} minutos`}><span aria-hidden="true">◷</span> {lesson.reading_minutes ?? 10} min de leitura</span>{formatChapterDate(lesson.created_at) && <span>Criado em {formatChapterDate(lesson.created_at)}</span>}{formatChapterDate(lesson.updated_at) && <span>Atualizado em {formatChapterDate(lesson.updated_at)}</span>}</div>
          <div class="chapter-tabs" role="tablist" aria-label={`Conteúdo de ${lesson.title}`}><button type="button" id={`${lesson.slug}-theory-tab`} role="tab" aria-selected="true" aria-controls={`${lesson.slug}-theory`} data-chapter-tab="theory">Teoria</button><button type="button" id={`${lesson.slug}-practice-tab`} role="tab" aria-selected="false" aria-controls={`${lesson.slug}-practice`} data-chapter-tab="practice">Guia de bancada</button></div>
          <button type="button" class="download-chapter-pdf" data-download-chapter title="Na janela de impressão, escolha Salvar como PDF."><span aria-hidden="true">⇩</span> Salvar capítulo em PDF</button>
          <section id={`${lesson.slug}-theory`} role="tabpanel" aria-labelledby={`${lesson.slug}-theory-tab`} data-chapter-panel="theory">
            {lesson.key_idea && <blockquote class="key-idea"><span class="text-5xl font-display leading-none text-accent-light">“</span><p>{lesson.key_idea}</p></blockquote>}
            <article class="prose prose-base mt-7 max-w-none prose-headings:font-display prose-headings:font-semibold prose-a:text-accent-light dark:prose-invert" set:html={lesson.body_html}></article>
            {lesson.essential_points?.length > 0 && <section class="essential-card"><p class="text-[10px] font-bold uppercase tracking-[.18em] text-accent-light">Hora de memorizar</p><h3 class="mt-2 font-display text-3xl font-semibold">O essencial deste capítulo</h3><ol class="mt-5 grid gap-4 sm:grid-cols-2">{lesson.essential_points.map((point: any, index: number) => <li class="flex gap-3"><span class="grid h-7 w-7 shrink-0 place-items-center rounded-full border border-black/30 text-xs">{index + 1}</span><span><strong class="block text-sm">{point.title}</strong><small class="mt-1 block leading-relaxed">{point.description}</small></span></li>)}</ol></section>}
          </section>
          <section id={`${lesson.slug}-practice`} role="tabpanel" aria-labelledby={`${lesson.slug}-practice-tab`} data-chapter-panel="practice" hidden>
            {lesson.practice_markdown ? <section class="guided-practice"><p class="text-[10px] font-bold uppercase tracking-[.18em] text-accent-light">Guia de bancada</p><h3 class="mt-2 font-display text-3xl font-semibold">{lesson.shortcuts?.[0]?.label ? `Prática: ${lesson.shortcuts[0].label}` : 'Prática guiada'}</h3><p class="mt-2 text-sm text-text-muted-light dark:text-text-muted-dark">Execute as etapas na ordem indicada e confira o resultado antes de avançar.</p><article class="prose prose-sm mt-6 max-w-none prose-headings:font-display prose-headings:font-semibold prose-blockquote:border-l-highlight-light prose-blockquote:bg-white/60 prose-blockquote:px-4 prose-blockquote:py-1 dark:prose-invert dark:prose-blockquote:bg-black/10" set:html={lesson.practice_html}></article></section> : <div class="practice-empty"><span aria-hidden="true">✳</span><h3>Guia de bancada em preparação</h3><p>O professor ainda não adicionou uma atividade prática para este capítulo.</p></div>}
          </section>
          {nextLesson && unlockedLessons.has(nextLesson.slug) && <a data-select-chapter href={`#${nextLesson.slug}`} class="next-chapter"><span class="text-[9px] font-bold uppercase tracking-widest">Próximo capítulo</span><strong class="mt-1 block font-display text-lg">{nextLesson.title}</strong><span aria-hidden="true" class="absolute right-5 top-1/2 -translate-y-1/2 rounded-full border border-white/40 px-3 py-2">›</span></a>}
          </>}
        </article>; })}
      </section>)}
      {withoutModule.length > 0 && <section class="module-content" hidden><div class="module-heading"><span class="text-xs font-bold uppercase tracking-widest text-accent-light">Conteúdo</span><span class="mx-2 h-px w-8 bg-border-light"></span><span class="text-xs font-bold uppercase tracking-widest">Capítulos</span></div>{withoutModule.map((lesson: any) => { const unlocked = unlockedLessons.has(lesson.slug); return <article id={lesson.slug} data-chapter data-lesson={lesson.slug} data-title={lesson.title} data-unlocked={unlocked} class="chapter-article scroll-mt-24" hidden>{!unlocked ? <div class="chapter-locked-message">Conclua os capítulos anteriores para liberar este conteúdo.</div> : <>{isAdmin && <div class="reader-edit-actions"><button type="button" class="reader-edit-chapter" data-edit-reader-chapter={lesson.slug} aria-label="Editar capítulo" title="Editar capítulo"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L8 18l-4 1 1-4Z"/></svg></button></div>}<div class="chapter-title-row"><span>{String(lesson.lesson_order + 1).padStart(2, '0')}</span><h2 data-chapter-title class="font-display text-3xl font-semibold">{lesson.title}</h2></div><div class="chapter-tabs" role="tablist" aria-label={`Conteúdo de ${lesson.title}`}><button type="button" id={`${lesson.slug}-theory-tab`} role="tab" aria-selected="true" aria-controls={`${lesson.slug}-theory`} data-chapter-tab="theory">Teoria</button><button type="button" id={`${lesson.slug}-practice-tab`} role="tab" aria-selected="false" aria-controls={`${lesson.slug}-practice`} data-chapter-tab="practice">Guia de bancada</button></div><button type="button" class="download-chapter-pdf" data-download-chapter title="Na janela de impressão, escolha Salvar como PDF."><span aria-hidden="true">⇩</span> Salvar capítulo em PDF</button><section id={`${lesson.slug}-theory`} role="tabpanel" aria-labelledby={`${lesson.slug}-theory-tab`} data-chapter-panel="theory"><article class="prose mt-7 max-w-none prose-headings:font-display prose-headings:font-semibold prose-a:text-accent-light dark:prose-invert" set:html={lesson.body_html}></article></section><section id={`${lesson.slug}-practice`} role="tabpanel" aria-labelledby={`${lesson.slug}-practice-tab`} data-chapter-panel="practice" hidden><div class="practice-empty"><span aria-hidden="true">✳</span><h3>Guia de bancada em preparação</h3><p>O professor ainda não adicionou uma atividade prática para este capítulo.</p></div></section></>}</article>; })}</section>}
      {chapterCount === 0 && <p class="rounded-2xl border border-dashed border-border-light p-8 text-center text-text-muted-light dark:border-border-dark dark:text-text-muted-dark">Ainda não há capítulos publicados nesta disciplina.</p>}
    </main>

    <aside class="reader-right"><div class="reader-right-inner"><section id="notes-panel" class="note-panel" hidden><div class="flex items-center gap-2"><span aria-hidden="true">▤</span><p class="text-[10px] font-bold uppercase tracking-widest">Minhas notas</p></div><p id="active-chapter-title" class="mt-2 truncate text-xs text-text-muted-light dark:text-text-muted-dark"></p><textarea id="lesson-note" class="note-editor mt-3 min-h-40 w-full resize-y rounded-xl border border-border-light bg-surface-light p-3 text-sm leading-relaxed outline-none transition focus:border-accent-light focus:ring-2 focus:ring-accent-light/15 dark:border-border-dark dark:bg-surface-dark" placeholder="Registre uma ideia, dúvida ou atalho…" disabled></textarea><div class="mt-3 grid gap-2"><p id="note-state" class="text-[10px] text-text-muted-light dark:text-text-muted-dark" aria-live="polite">Suas anotações são privadas.</p><button id="save-note" type="button" class="note-save-button" disabled><span aria-hidden="true">↥</span><span>Salvar minhas notas</span></button></div><p class="mt-2 text-[9px] text-text-muted-light dark:text-text-muted-dark">Salve quando terminar de escrever.</p></section><section id="shortcuts-panel" class="shortcut-panel mt-6 rounded-2xl bg-[#e9e5da] p-4 dark:bg-surface-dark" hidden><p class="text-[9px] font-bold uppercase tracking-widest text-accent-light">Atalhos da aula</p><div id="active-shortcuts" class="mt-3 text-xs text-text-muted-light dark:text-text-muted-dark"></div></section><a id="practice-shortcut" href="#" class="mt-3 hidden items-center gap-3 rounded-xl bg-[#14231e] p-4 text-white"><span class="grid h-8 w-8 place-items-center rounded-full bg-highlight-light text-black">▶</span><span><small class="block text-[8px] uppercase tracking-widest text-white/60">Prática guiada</small><strong class="text-xs">Ir para o exercício</strong></span></a><button id="complete-chapter" type="button" data-complete data-discipline={discipline} data-lesson="" data-completed="false" class="complete-button mt-3 hidden"><span aria-hidden="true">○</span><span>Marcar como concluída</span></button><p id="reader-panel-hint" class="rounded-xl border border-dashed border-border-light p-4 text-xs leading-relaxed text-text-muted-light dark:border-border-dark dark:text-text-muted-dark">Clique em um capítulo no sumário para abrir os atalhos e suas notas pessoais.</p></div></aside>
  </div>
</BaseLayout>

{isAdmin && <dialog id="reader-edit-dialog" class="reader-edit-dialog"><form id="reader-edit-form"><header class="reader-edit-header"><div><p>EDIÇÃO DO CAPÍTULO</p><h2>Editar na apostila</h2></div><button type="button" data-reader-edit-close aria-label="Fechar">×</button></header><input type="hidden" name="id" /><input type="hidden" name="discipline_slug" value={discipline} /><input type="hidden" name="published" value="true" /><input type="hidden" name="shortcut_keys" value="" /><input type="hidden" name="shortcut_label" value="" /><input type="hidden" name="access_keyword" value="" /><input type="hidden" name="clear_access_keyword" value="false" /><div class="reader-edit-grid"><label>Título<input name="title" required maxlength="180" /></label><label>Slug<input name="slug" required /></label><label>Módulo<select name="module_id"><option value="">Sem módulo</option>{modules.map((module) => <option value={module.id}>{module.name}</option>)}</select></label><label>Ordem no módulo<input type="number" name="lesson_order" min="0" /></label><label>Tempo de leitura (minutos)<input type="number" name="reading_minutes" min="1" max="999" /></label><label>Nível<input name="difficulty" /></label><label class="wide">Tags (separadas por vírgulas)<input name="tags" /></label><label class="wide">Apresentação / resumo<textarea name="summary" rows="2"></textarea></label><label class="wide">Ideia-chave<textarea name="key_idea" rows="2"></textarea></label><label class="wide">Hora de memorizar (um ponto por linha: Título | explicação)<textarea name="essential_points" rows="3"></textarea></label><label class="wide">Atalhos (um por linha: teclas | ferramenta)<textarea name="shortcuts_text" rows="3"></textarea></label><label class="wide">Teoria (Markdown)<textarea name="body_markdown" rows="12" required></textarea></label><label class="wide">Guia de bancada (Markdown)<textarea name="practice_markdown" rows="10"></textarea></label></div><p id="reader-edit-status" role="status" aria-live="polite"></p><footer><button type="button" data-reader-edit-close>Cancelar</button><button type="submit" class="reader-edit-save">Salvar alterações</button></footer></form></dialog>}

<script type="application/json" id="chapter-data" set:html={JSON.stringify({ discipline, chapters: lessons.map((lesson) => ({ slug: lesson.slug, shortcuts: lesson.shortcuts ?? (lesson.shortcut_keys ? [{ keys: lesson.shortcut_keys, label: lesson.shortcut_label }] : []), hasPractice: Boolean(lesson.practice_markdown), completed: completedLessons.has(lesson.slug), unlocked: unlockedLessons.has(lesson.slug), keywordPrompt: keywordPromptLessons.has(lesson.slug) })), ...(isAdmin ? { adminLessons: lessons.map(({ id, title, slug, module_id, lesson_order, reading_minutes, difficulty, summary, tags, key_idea, essential_points, shortcuts, shortcut_keys, shortcut_label, body_markdown, practice_markdown, published }) => ({ id, title, slug, module_id, lesson_order, reading_minutes, difficulty, summary, tags, key_idea, essential_points, shortcuts, shortcut_keys, shortcut_label, body_markdown, practice_markdown, published })) } : {}) }).replace(/</g, '\\u003c')}></script>
<script>
  const pageData = JSON.parse(document.querySelector('#chapter-data')?.textContent ?? '{"discipline":"","chapters":[]}');
  const { discipline, chapters: chapterData } = pageData;
  const chapters = [...document.querySelectorAll<HTMLElement>('[data-chapter]')];
  const note = document.querySelector<HTMLTextAreaElement>('#lesson-note');
  const saveNoteButton = document.querySelector<HTMLButtonElement>('#save-note');
  const noteState = document.querySelector<HTMLElement>('#note-state');
  const activeTitle = document.querySelector<HTMLElement>('#active-chapter-title');
  const shortcutList = document.querySelector<HTMLElement>('#active-shortcuts');
  const notePanel = document.querySelector<HTMLElement>('#notes-panel');
  const shortcutsPanel = document.querySelector<HTMLElement>('#shortcuts-panel');
  const panelHint = document.querySelector<HTMLElement>('#reader-panel-hint');
  const practiceLink = document.querySelector<HTMLAnchorElement>('#practice-shortcut');
  const completeButton = document.querySelector<HTMLButtonElement>('#complete-chapter');
  const welcomeNav = document.querySelector<HTMLAnchorElement>('#welcome-nav');
  const welcomePage = document.querySelector<HTMLElement>('#bem-vindo');
  const chapterBySlug = new Map(chapterData.map((item) => [item.slug, item]));
  const adminLessons = new Map((pageData.adminLessons ?? []).map((item: any) => [item.slug, item]));
  const editDialog = document.querySelector<HTMLDialogElement>('#reader-edit-dialog');
  const editForm = document.querySelector<HTMLFormElement>('#reader-edit-form');
  const editStatus = document.querySelector<HTMLElement>('#reader-edit-status');
  const editField = (name: string) => editForm?.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null;
  document.querySelectorAll<HTMLButtonElement>('[data-edit-reader-chapter]').forEach((button) => button.addEventListener('click', () => {
    const item = adminLessons.get(button.dataset.editReaderChapter ?? '');
    if (!item || !editForm || !editDialog) return;
    for (const name of ['id','title','slug','module_id','lesson_order','reading_minutes','difficulty','summary','key_idea','body_markdown','practice_markdown']) { const field = editField(name); if (field) field.value = String(item[name] ?? ''); }
    const tags = editField('tags'); if (tags) tags.value = (item.tags ?? []).join(', ');
    const points = editField('essential_points'); if (points) points.value = (item.essential_points ?? []).map((point: any) => `${point.title} | ${point.description ?? ''}`).join('\n');
    const shortcuts = editField('shortcuts_text'); if (shortcuts) shortcuts.value = (item.shortcuts?.length ? item.shortcuts : (item.shortcut_keys ? [{ keys: item.shortcut_keys, label: item.shortcut_label }] : [])).map((entry: any) => `${entry.keys} | ${entry.label}`).join('\n');
    if (editStatus) editStatus.textContent = '';
    editDialog.showModal();
  }));
  document.querySelectorAll<HTMLButtonElement>('[data-reader-edit-close]').forEach((button) => button.addEventListener('click', () => editDialog?.close()));
  editDialog?.addEventListener('click', (event) => { if (event.target === editDialog) editDialog.close(); });
  editForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const submit = editForm.querySelector<HTMLButtonElement>('[type="submit"]');
    if (submit) { submit.disabled = true; submit.textContent = 'Salvando…'; }
    if (editStatus) editStatus.textContent = 'Salvando alterações…';
    const raw = Object.fromEntries(new FormData(editForm).entries());
    const parseLines = (value: unknown) => String(value ?? '').split('\n').map((line) => { const [first, ...rest] = line.split('|'); return { first: first.trim(), rest: rest.join('|').trim() }; }).filter((line) => line.first);
    const payload = { ...raw,
      lesson_order: Number(raw.lesson_order) || 0,
      reading_minutes: Number(raw.reading_minutes) || 10,
      tags: String(raw.tags ?? '').split(',').map((tag) => tag.trim()).filter(Boolean),
      essential_points: parseLines(raw.essential_points).map(({ first, rest }) => ({ title: first, description: rest })),
      shortcuts: parseLines(raw.shortcuts_text).map(({ first, rest }) => ({ keys: first, label: rest })),
      published: true,
    };
    try {
      const response = await fetch('/api/admin/apostilas', { method: 'PUT', headers: { 'content-type': 'application/json' }, body: JSON.stringify(payload) });
      const result = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(result.error ?? 'Não foi possível salvar o capítulo.');
      if (editStatus) editStatus.textContent = 'Capítulo salvo. Atualizando a apostila…';
      location.reload();
    } catch (error) {
      if (editStatus) editStatus.textContent = error instanceof Error ? error.message : 'Não foi possível salvar o capítulo.';
      if (submit) { submit.disabled = false; submit.textContent = 'Salvar alterações'; }
    }
  });
  let activeSlug = '';
  let noteDirty = false;
  let loadCounter = 0;
  async function activateChapter(chapter: HTMLElement) {
    const slug = chapter.dataset.lesson ?? '';
    if (!slug || slug === activeSlug) return;
    const details = chapterBySlug.get(slug);
    if (!details?.unlocked) {
      if (details?.keywordPrompt) { /* O formulário da palavra-chave é exibido dentro do capítulo. */ } else { alert('Conclua os capítulos anteriores para liberar este conteúdo.'); return; }
    }
    if (noteDirty && !confirm('Sua anotação ainda não foi salva. Descartar as alterações?')) return;
    noteDirty = false;
    history.replaceState(null, '', `#${slug}`);
    activeSlug = slug;
    if (welcomePage) welcomePage.hidden = true;
    // Cada módulo contém vários capítulos. O módulo deve ser mostrado uma
    // única vez para o capítulo selecionado, depois de ocultarmos os demais.
    document.querySelectorAll<HTMLElement>('.module-content').forEach((module) => { module.hidden = true; });
    chapters.forEach((item) => {
      const selected = item === chapter;
      item.hidden = !selected;
    });
    chapter.closest<HTMLElement>('.module-content')?.removeAttribute('hidden');
    if (details?.keywordPrompt) {
      if (notePanel) notePanel.hidden = true; if (shortcutsPanel) shortcutsPanel.hidden = true;
      if (panelHint) panelHint.hidden = true; if (practiceLink) practiceLink.classList.add('hidden');
      if (completeButton) completeButton.classList.add('hidden');
      chapter.querySelector<HTMLFormElement>('[data-unlock-form]')?.querySelector<HTMLInputElement>('input[name=keyword]')?.focus({ preventScroll: true });
      return;
    }
    if (notePanel) notePanel.hidden = false;
    if (shortcutsPanel) shortcutsPanel.hidden = false;
    if (panelHint) panelHint.hidden = true;
    welcomeNav?.classList.remove('selected-chapter-link');
    document.querySelectorAll<HTMLAnchorElement>('#chapter-nav a[href^="#"]').forEach((link) => {
      const selected = link.getAttribute('href') === `#${slug}`;
      link.classList.toggle('selected-chapter-link', selected);
      if (selected) link.setAttribute('aria-current', 'true'); else link.removeAttribute('aria-current');
    });
    if (activeTitle) activeTitle.textContent = chapter.dataset.title ?? 'Minhas notas';
    if (completeButton) {
      const completed = Boolean(details?.completed);
      completeButton.dataset.lesson = slug;
      completeButton.dataset.completed = String(completed);
      completeButton.disabled = completed;
      completeButton.classList.remove('hidden');
      completeButton.querySelector('span')!.textContent = completed ? '✓' : '○';
      completeButton.querySelectorAll('span')[1]!.textContent = completed ? 'Aula concluída' : 'Marcar como concluída';
    }
    if (shortcutList) {
      shortcutList.replaceChildren();
      if (details?.shortcuts.length) details.shortcuts.forEach((shortcut) => {
        const item = document.createElement('div'); item.className = 'mb-3 last:mb-0';
        const keys = document.createElement('kbd'); keys.className = 'rounded border border-border-light px-2 py-1 font-mono text-[10px] dark:border-border-dark'; keys.textContent = shortcut.keys;
        const label = document.createElement('p'); label.className = 'mt-2 font-semibold'; label.textContent = shortcut.label;
        item.append(keys, label); shortcutList.append(item);
      });
      else shortcutList.textContent = 'Nenhum atalho cadastrado para este capítulo.';
    }
    if (practiceLink) { practiceLink.href = `#${slug}-practice`; practiceLink.classList.toggle('hidden', !details?.hasPractice); practiceLink.classList.toggle('flex', Boolean(details?.hasPractice)); }
    if (!note) return;
    const requestId = ++loadCounter;
    note.disabled = true; note.value = ''; if (noteState) noteState.textContent = 'Carregando suas anotações…';
    try {
      const response = await fetch(`/api/notes?discipline=${encodeURIComponent(discipline)}&lesson=${encodeURIComponent(slug)}`);
      if (!response.ok) throw new Error('Entre para sincronizar suas anotações.');
      const result = await response.json();
      if (requestId !== loadCounter) return;
      note.value = result.note?.content ?? ''; note.disabled = false;
      noteDirty = false;
      if (saveNoteButton) saveNoteButton.disabled = true;
      if (noteState) noteState.textContent = note.value ? 'Anotação sincronizada.' : 'Suas anotações são privadas.';
    } catch (error) { if (noteState) noteState.textContent = error instanceof Error ? error.message : 'Não foi possível carregar as notas.'; }
  }
  chapters.forEach((chapter) => {
    const tabs = [...chapter.querySelectorAll<HTMLButtonElement>('[data-chapter-tab]')];
    const panels = [...chapter.querySelectorAll<HTMLElement>('[data-chapter-panel]')];
    tabs.forEach((tab) => tab.addEventListener('click', () => {
      const selected = tab.dataset.chapterTab;
      tabs.forEach((item) => {
        const isSelected = item === tab;
        item.setAttribute('aria-selected', String(isSelected));
        item.tabIndex = isSelected ? 0 : -1;
      });
      panels.forEach((panel) => { panel.hidden = panel.dataset.chapterPanel !== selected; });
    }));
    chapter.querySelector<HTMLButtonElement>('[data-download-chapter]')?.addEventListener('click', () => {
      const previousTitle = document.title;
      const panels = [...chapter.querySelectorAll<HTMLElement>('[data-chapter-panel]')];
      const originalPanelState = panels.map((panel) => ({ panel, wasHidden: panel.hidden, display: panel.style.display }));
      panels.forEach((panel) => { panel.hidden = false; panel.style.display = 'block'; });
      document.title = `${chapter.dataset.title ?? previousTitle} — Professor Deivid Nobre`;
      window.addEventListener('afterprint', () => {
        document.title = previousTitle;
        originalPanelState.forEach(({ panel, wasHidden, display }) => {
          panel.hidden = wasHidden;
          panel.style.display = display;
        });
      }, { once: true });
      window.print();
    });
  });
  practiceLink?.addEventListener('click', (event) => {
    const slug = activeSlug;
    const chapter = chapters.find((item) => item.dataset.lesson === slug);
    if (!chapter) return;
    event.preventDefault();
    chapter.querySelector<HTMLButtonElement>('[data-chapter-tab="practice"]')?.click();
    chapter.querySelector<HTMLElement>('[data-chapter-panel="practice"]')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
  document.querySelectorAll<HTMLAnchorElement>('[data-select-chapter][href^="#"]').forEach((link) => link.addEventListener('click', () => {
    const slug = link.getAttribute('href')?.slice(1);
    const chapter = chapters.find((item) => item.dataset.lesson === slug);
    if (chapter) activateChapter(chapter);
  }));
  document.querySelectorAll<HTMLAnchorElement>('[data-locked="true"]').forEach((link) => link.addEventListener('click', (event) => {
    event.preventDefault();
    alert('Conclua os capítulos anteriores para liberar este conteúdo.');
  }));
  document.querySelectorAll<HTMLFormElement>('[data-unlock-form]').forEach((form) => form.addEventListener('submit', async (event) => {
    event.preventDefault(); const input = form.querySelector<HTMLInputElement>('input[name=keyword]')!; const status = form.querySelector<HTMLElement>('[data-unlock-status]')!; const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    if (!input.value) { form.querySelector<HTMLElement>('[data-fruit-selection-status]')!.textContent = 'Selecione quatro frutas para liberar o capítulo.'; return; }
    button.disabled = true; button.textContent = 'Verificando…'; status.textContent = '';
    try { const response = await fetch('/api/lesson-unlock', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ discipline_slug: form.dataset.discipline, lesson_slug: form.dataset.lesson, keyword: input.value }) }); const result = await response.json(); if (!response.ok) throw new Error(result.error ?? 'Não foi possível liberar o capítulo.'); status.textContent = 'Capítulo liberado! Carregando conteúdo…'; location.reload(); }
    catch (error) { status.textContent = error instanceof Error ? error.message : 'Não foi possível validar a palavra-chave.'; form.querySelector<HTMLButtonElement>('[data-fruit-slot]')?.focus({ preventScroll: true }); }
    finally { button.disabled = false; button.textContent = 'Liberar capítulo'; }
  }));
  document.querySelectorAll<HTMLFormElement>('[data-unlock-form]').forEach((form) => {
    const slots = [...form.querySelectorAll<HTMLButtonElement>('[data-fruit-slot]')];
    const choices = [...form.querySelectorAll<HTMLButtonElement>('[data-fruit-choice]')];
    const selects = [...form.querySelectorAll<HTMLSelectElement>('[data-fruit-select]')];
    const keywordInput = form.querySelector<HTMLInputElement>('input[name="keyword"]')!;
    const selectionStatus = form.querySelector<HTMLElement>('[data-fruit-selection-status]')!;
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const chosen = () => slots.map((slot) => slot.dataset.emoji ?? '');
    const render = () => {
      const sequence = chosen();
      const count = sequence.filter(Boolean).length;
      slots.forEach((slot, position) => {
        const emoji = sequence[position];
        const name = choices.find((choice) => choice.dataset.fruitChoice === emoji)?.dataset.fruitName;
        slot.textContent = emoji || '＋';
        slot.setAttribute('aria-label', emoji ? `Fruta ${position + 1}: ${name}. Clique para remover.` : `Fruta ${position + 1}: não selecionada`);
        slot.classList.toggle('is-filled', Boolean(emoji));
      });
      selects.forEach((select, position) => { select.value = sequence[position]; });
      choices.forEach((choice) => choice.setAttribute('aria-pressed', String(sequence.includes(choice.dataset.fruitChoice ?? ''))));
      keywordInput.value = count === 4 ? sequence.join('-') : '';
      submit.disabled = count !== 4;
      selectionStatus.textContent = count === 4
        ? `Sequência escolhida: ${sequence.map((emoji) => choices.find((choice) => choice.dataset.fruitChoice === emoji)?.dataset.fruitName).join(', ')}.`
        : `${count} de 4 frutas selecionadas.`;
    };
    choices.forEach((choice) => choice.addEventListener('click', () => {
      const slot = slots.find((item) => !item.dataset.emoji);
      if (!slot) { selectionStatus.textContent = 'A sequência já tem quatro frutas. Desfaça ou limpe para alterar.'; return; }
      slot.dataset.emoji = choice.dataset.fruitChoice ?? '';
      render();
    }));
    slots.forEach((slot, position) => slot.addEventListener('click', () => {
      if (!slot.dataset.emoji) return;
      const sequence = chosen().filter(Boolean);
      sequence.splice(position, 1);
      slots.forEach((item, index) => { item.dataset.emoji = sequence[index] ?? ''; });
      render();
    }));
    selects.forEach((select) => select.addEventListener('change', () => {
      const position = Number(select.dataset.fruitSelect);
      slots[position].dataset.emoji = select.value;
      render();
    }));
    form.querySelector<HTMLButtonElement>('[data-fruit-undo]')?.addEventListener('click', () => {
      const sequence = chosen().filter(Boolean); sequence.pop();
      slots.forEach((slot, index) => { slot.dataset.emoji = sequence[index] ?? ''; });
      render();
    });
    form.querySelector<HTMLButtonElement>('[data-fruit-clear]')?.addEventListener('click', () => {
      slots.forEach((slot) => { slot.dataset.emoji = ''; }); render();
    });
    render();
  });
  welcomeNav?.addEventListener('click', () => {
    if (noteDirty && !confirm('Sua anotação ainda não foi salva. Descartar as alterações?')) return;
    noteDirty = false;
    activeSlug = '';
    loadCounter++;
    if (welcomePage) welcomePage.hidden = false;
    document.querySelectorAll<HTMLElement>('.module-content').forEach((module) => { module.hidden = true; });
    chapters.forEach((chapter) => { chapter.hidden = true; });
    if (notePanel) notePanel.hidden = true;
    if (shortcutsPanel) shortcutsPanel.hidden = true;
    if (practiceLink) practiceLink.classList.add('hidden');
    if (completeButton) completeButton.classList.add('hidden');
    if (completeButton) { completeButton.dataset.lesson = ''; completeButton.dataset.completed = 'false'; }
    if (panelHint) panelHint.hidden = false;
    welcomeNav.classList.add('selected-chapter-link');
    document.querySelectorAll<HTMLAnchorElement>('#chapter-nav a[href^="#"]').forEach((link) => { link.classList.remove('selected-chapter-link'); link.removeAttribute('aria-current'); });
  });
  chapters.forEach((chapter) => chapter.querySelector<HTMLElement>('[data-chapter-title]')?.addEventListener('click', () => activateChapter(chapter)));
  const hashChapter = chapters.find((chapter) => chapter.dataset.lesson === decodeURIComponent(location.hash.slice(1)));
  if (hashChapter) activateChapter(hashChapter);
  note?.addEventListener('input', () => {
    noteDirty = true;
    if (saveNoteButton) saveNoteButton.disabled = note.disabled;
    if (noteState) noteState.textContent = 'Alterações não salvas.';
  });
  saveNoteButton?.addEventListener('click', async () => {
    const slug = activeSlug;
    if (!slug || !note || note.disabled) return;
    saveNoteButton.disabled = true; saveNoteButton.querySelectorAll('span')[1].textContent = 'Salvando…';
    if (noteState) noteState.textContent = 'Salvando sua anotação…';
    try {
      const response = await fetch('/api/notes', { method: 'PUT', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ discipline_slug: discipline, lesson_slug: slug, content: note.value }) });
      if (!response.ok) throw new Error('Não foi possível salvar sua anotação.');
      noteDirty = false;
      if (slug === activeSlug && noteState) noteState.textContent = 'Anotação salva.';
    } catch (error) {
      if (slug === activeSlug && noteState) noteState.textContent = error instanceof Error ? error.message : 'Não foi possível salvar sua anotação.';
    } finally {
      saveNoteButton.querySelectorAll('span')[1].textContent = 'Salvar minhas notas';
      if (slug === activeSlug) saveNoteButton.disabled = !noteDirty;
    }
  });
  const filter = document.querySelector<HTMLInputElement>('#chapter-filter');
  filter?.addEventListener('input', () => {
    const value = filter.value.toLocaleLowerCase('pt-BR').trim();
    document.querySelectorAll<HTMLElement>('[data-search-item]').forEach((item) => { item.hidden = !item.dataset.searchText?.toLocaleLowerCase('pt-BR').includes(value); });
    document.querySelectorAll<HTMLDetailsElement>('.module-group').forEach((group) => { const hasMatch = [...group.querySelectorAll<HTMLElement>('[data-search-item]')].some((item) => !item.hidden); if (value && hasMatch) group.open = true; group.hidden = Boolean(value) && !hasMatch; });
  });
  const mobileSearchToggle = document.querySelector<HTMLButtonElement>('#mobile-chapter-search-toggle');
  const mobileSearchPanel = document.querySelector<HTMLElement>('#mobile-chapter-search-panel');
  const mobileSearchInput = document.querySelector<HTMLInputElement>('#mobile-chapter-filter');
  const mobileSearchClose = document.querySelector<HTMLButtonElement>('#mobile-chapter-search-close');
  const mobileSearchItems = [...document.querySelectorAll<HTMLButtonElement>('[data-mobile-search-item]')];
  const mobileSearchEmpty = document.querySelector<HTMLElement>('#mobile-chapter-search-empty');
  const closeMobileSearch = (returnFocus = false) => {
    if (!mobileSearchPanel || !mobileSearchToggle) return;
    mobileSearchPanel.hidden = true;
    mobileSearchToggle.setAttribute('aria-expanded', 'false');
    if (returnFocus) mobileSearchToggle.focus();
  };
  mobileSearchToggle?.addEventListener('click', () => {
    if (!mobileSearchPanel) return;
    const open = mobileSearchPanel.hidden;
    mobileSearchPanel.hidden = !open;
    mobileSearchToggle.setAttribute('aria-expanded', String(open));
    if (open) { if (mobileSearchInput) mobileSearchInput.value = ''; mobileSearchItems.forEach((item) => { item.hidden = false; }); if (mobileSearchEmpty) mobileSearchEmpty.hidden = true; }
  });
  mobileSearchClose?.addEventListener('click', () => closeMobileSearch(true));
  mobileSearchInput?.addEventListener('input', () => {
    const normalize = (value: string) => value.toLocaleLowerCase('pt-BR').normalize('NFD').replace(/[\u0300-\u036f]/g, '');
    const value = normalize(mobileSearchInput.value.trim());
    let matches = 0;
    mobileSearchItems.forEach((item) => { const visible = normalize(item.dataset.title ?? '').includes(value); item.hidden = !visible; if (visible) matches++; });
    if (mobileSearchEmpty) mobileSearchEmpty.hidden = matches > 0;
  });
  mobileSearchItems.forEach((item) => item.addEventListener('click', () => {
    const slug = item.dataset.slug;
    const chapter = chapters.find((entry) => entry.dataset.lesson === slug);
    if (!chapter || item.dataset.unlocked !== 'true') return;
    void activateChapter(chapter);
    if (activeSlug === slug) { closeMobileSearch(); requestAnimationFrame(() => chapter.scrollIntoView({ behavior: 'smooth', block: 'start' })); }
  }));
  completeButton?.addEventListener('click', async () => {
    if (!completeButton.dataset.lesson || completeButton.dataset.completed === 'true') return;
    completeButton.disabled = true;
    try {
      const response = await fetch('/api/progress', { method: 'PUT', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ discipline_slug: completeButton.dataset.discipline, lesson_slug: completeButton.dataset.lesson, completed: true }) });
      const result = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(result.error ?? 'Não foi possível salvar seu progresso.');
      completeButton.dataset.completed = 'true';
      completeButton.querySelector('span')!.textContent = '✓';
      completeButton.querySelectorAll('span')[1]!.textContent = 'Aula concluída';
      const chapter = chapters.find((item) => item.dataset.lesson === completeButton.dataset.lesson);
      if (chapter) { const details = chapterBySlug.get(completeButton.dataset.lesson); if (details) details.completed = true; }
      // Recarrega os vínculos de progresso no servidor; assim o próximo capítulo
      // só recebe conteúdo depois que a conclusão anterior foi persistida.
      location.reload();
    } catch (error) {
      alert(error instanceof Error ? error.message : 'Não foi possível salvar o progresso.');
      completeButton.disabled = false;
    }
  });
</script>

