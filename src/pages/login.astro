---
import BaseLayout from '../layouts/BaseLayout.astro';
import { createSupabaseServerClient } from '../lib/supabase';
let message = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData(); const email = String(form.get('email') ?? ''); const password = String(form.get('password') ?? '');
  try {
    const supabase = createSupabaseServerClient(Astro.cookies, Astro.request);
    const { data, error } = await supabase.auth.signInWithPassword({ email, password });
    if (error) message = error.message;
    else {
      const profile = await supabase.from('profiles').select('is_active,role').eq('id', data.user.id).maybeSingle();
      if (profile.data?.is_active && profile.data.role === 'admin') return Astro.redirect('/admin');
      if (profile.data?.is_active) return Astro.redirect('/');
      return Astro.redirect('/aguardando-aprovacao');
    }
  }
  catch (error) { message = error instanceof Error ? error.message : 'Não foi possível entrar.'; }
}
---
<BaseLayout title="Entrar — Professor Deivid Nobre - Apostilas"><main class="mx-auto max-w-md px-5 py-16"><a href="/" class="text-sm text-text-muted-light">← Início</a><p class="mt-10 text-xs font-bold uppercase tracking-[.2em] text-accent-light">Bem-vindo de volta</p><h1 class="mt-2 font-display text-4xl font-semibold">Entre na sua conta</h1><p class="mt-3 text-text-muted-light dark:text-text-muted-dark">Seu progresso e suas anotações ficam guardados por aqui.</p><form method="post" class="mt-8 space-y-4"><label class="block text-sm font-medium">E-mail<input required type="email" name="email" autocomplete="email" class="mt-2 w-full rounded-xl border border-border-light bg-surface-light px-4 py-3 dark:border-border-dark dark:bg-surface-dark" /></label><label class="block text-sm font-medium">Senha<input required type="password" name="password" autocomplete="current-password" class="mt-2 w-full rounded-xl border border-border-light bg-surface-light px-4 py-3 dark:border-border-dark dark:bg-surface-dark" /></label>{message && <p role="alert" class="text-sm text-red-600">{message}</p>}<button class="w-full rounded-full bg-accent-light px-5 py-3 font-semibold text-white">Entrar</button></form><p class="mt-6 text-sm text-text-muted-light">Ainda não tem conta? <a class="font-semibold text-accent-light" href="/signup">Criar conta</a></p></main></BaseLayout>
