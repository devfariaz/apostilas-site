---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { createSupabaseServerClient } from '../../../lib/supabase';

export const prerender = false;

const supabase = createSupabaseServerClient(Astro.cookies, Astro.request);
const [authResult, guideResult, chapterResult, disciplineResult] = await Promise.all([
  supabase.auth.getUser(),
  supabase.from('teacher_guides').select('id,discipline_slug,module_id,title'),
  supabase.from('teacher_guide_chapters').select('id,guide_id'),
  supabase.from('disciplines').select('slug,name,description').order('sort_order'),
]);
const user = authResult.data.user;
const loadError = Boolean(guideResult.error || chapterResult.error || disciplineResult.error);
const chapters = chapterResult.data ?? [];
const guideCards = (disciplineResult.data ?? []).map((discipline) => {
  const guides = (guideResult.data ?? []).filter((guide) => guide.discipline_slug === discipline.slug);
  return {
    ...discipline,
    guides,
    chapterCount: chapters.filter((chapter) => guides.some((guide) => guide.id === chapter.guide_id)).length,
  };
}).filter((discipline) => discipline.guides.length > 0);
---

<BaseLayout title="Guias do professor — Professor Deivid Nobre - Apostilas" description="Biblioteca privada de guias e materiais do professor." user={user}>
  <main class="teacher-hub">
    <a href="/admin" class="teacher-hub-back">← Painel administrativo</a>
    <header class="teacher-hub-header">
      <p class="teacher-eyebrow">Área exclusiva do professor</p>
      <h1>Guias de ensino</h1>
      <p>Escolha uma disciplina para abrir seus módulos, capítulos e materiais de aula.</p>
    </header>

    {loadError ? <p class="teacher-hub-empty" role="alert">Não foi possível carregar as disciplinas. Atualize a página e tente novamente.</p> : guideCards.length ? <section class="teacher-hub-grid" aria-label="Disciplinas com guias cadastrados">
      {guideCards.map((discipline) => <a class="teacher-discipline-card" href={`/professor/guias/${encodeURIComponent(discipline.slug)}`}>
        <span class="teacher-card-icon" aria-hidden="true">▤</span>
        <span class="teacher-card-copy"><small>GUIA DO PROFESSOR</small><strong>{discipline.name}</strong><span>{discipline.guides.length} {discipline.guides.length === 1 ? 'módulo' : 'módulos'} · {discipline.chapterCount} {discipline.chapterCount === 1 ? 'capítulo' : 'capítulos'}</span></span>
        <span class="teacher-card-arrow" aria-hidden="true">↗</span>
      </a>)}
    </section> : <p class="teacher-hub-empty">Ainda não há guias cadastrados. Quando um guia for adicionado, a disciplina aparecerá aqui.</p>}

    <p class="teacher-hub-private"><span aria-hidden="true">▣</span> Biblioteca privada: os guias aparecem somente na sua conta de professor.</p>
  </main>
</BaseLayout>

<style>
  .teacher-hub { width:min(1100px, calc(100% - 36px)); margin:0 auto; padding:36px 0 72px; }
  .teacher-hub-back { color:var(--color-accent-light); font-size:12px; font-weight:700; }
  .teacher-hub-header { margin:42px 0 34px; max-width:680px; }
  .teacher-eyebrow { color:var(--color-accent-light); font-size:10px; font-weight:800; letter-spacing:.17em; text-transform:uppercase; }
  .teacher-hub-header h1 { margin:10px 0 8px; font-family:'Orbitron',sans-serif; font-size:clamp(27px,4vw,42px); font-weight:700; line-height:1.15; }
  .teacher-hub-header>p:last-child { color:var(--color-text-muted-light); font-size:15px; line-height:1.6; }
  .teacher-hub-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:16px; }
  .teacher-discipline-card { display:flex; min-height:138px; align-items:center; gap:15px; border:1px solid var(--color-border-light); border-radius:20px; background:var(--color-surface-light); padding:22px; transition:transform .18s,border-color .18s,box-shadow .18s; }
  .teacher-discipline-card:hover { transform:translateY(-2px); border-color:color-mix(in srgb,var(--color-accent-light) 45%,var(--color-border-light)); box-shadow:0 12px 30px #0000000b; }
  .teacher-card-icon { display:grid; width:48px; height:48px; flex:none; place-items:center; border-radius:15px; background:color-mix(in srgb,var(--color-accent-light) 12%,transparent); color:var(--color-accent-light); font-size:22px; }
  .teacher-card-copy { display:grid; min-width:0; gap:6px; }
  .teacher-card-copy small { color:var(--color-accent-light); font-size:9px; font-weight:800; letter-spacing:.14em; }
  .teacher-card-copy strong { font-family:'Orbitron',sans-serif; font-size:15px; line-height:1.35; }
  .teacher-card-copy>span { color:var(--color-text-muted-light); font-size:11px; }
  .teacher-card-arrow { margin-left:auto; align-self:flex-start; color:var(--color-text-muted-light); font-size:17px; }
  .teacher-hub-private,.teacher-hub-empty { margin-top:24px; border:1px solid var(--color-border-light); border-radius:14px; padding:14px 16px; color:var(--color-text-muted-light); font-size:12px; line-height:1.6; }
  .teacher-hub-private { display:flex; align-items:center; gap:9px; }
  .teacher-hub-private span { color:var(--color-accent-light); }
  :global(.dark) .teacher-hub-header>p:last-child,:global(.dark) .teacher-card-copy>span,:global(.dark) .teacher-card-arrow,:global(.dark) .teacher-hub-private,:global(.dark) .teacher-hub-empty { color:var(--color-text-muted-dark); }
  :global(.dark) .teacher-discipline-card,:global(.dark) .teacher-hub-private,:global(.dark) .teacher-hub-empty { border-color:var(--color-border-dark); background:var(--color-surface-dark); }
  @media(max-width:650px) { .teacher-hub { padding-top:22px; } .teacher-hub-header { margin:30px 0 24px; } .teacher-hub-grid { grid-template-columns:1fr; gap:11px; } .teacher-discipline-card { min-height:112px; padding:17px; } }
</style>
