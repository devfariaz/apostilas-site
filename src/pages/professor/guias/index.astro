---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { createSupabaseServerClient } from '../../../lib/supabase';
export const prerender = false;

const supabase = createSupabaseServerClient(Astro.cookies, Astro.request);
const [{ data: userResult }, { data: guideRows }, { data: disciplineRows }, { data: moduleRows }] = await Promise.all([
  supabase.auth.getUser(),
  supabase.from('teacher_guides').select('id,discipline_slug,module_id,title,source_filename,storage_path,page_count,created_at,updated_at').order('created_at'),
  supabase.from('disciplines').select('slug,name').order('sort_order'),
  supabase.from('modules').select('id,name,discipline_slug,sort_order').order('sort_order'),
]);
const user = userResult.user;
const disciplines = disciplineRows ?? [];
const modules = moduleRows ?? [];
const guides = (guideRows ?? []).map((guide) => ({
  ...guide,
  disciplineName: disciplines.find((discipline) => discipline.slug === guide.discipline_slug)?.name ?? guide.discipline_slug,
  moduleName: modules.find((module) => module.id === guide.module_id)?.name ?? 'Módulo',
}));
const requestedGuide = Astro.url.searchParams.get('guia');
const selectedGuide = guides.find((guide) => guide.id === requestedGuide) ?? guides[0] ?? null;
let signedUrl: string | null = null;
let viewerError = false;
if (selectedGuide) {
  const { data, error } = await supabase.storage.from('teacher-guides').createSignedUrl(selectedGuide.storage_path, 60 * 60);
  signedUrl = data?.signedUrl ?? null;
  viewerError = Boolean(error || !signedUrl);
}
---
<BaseLayout title="Guias do professor — Professor Deivid Nobre - Apostilas" description="Biblioteca privada de guias e materiais do professor." user={user}>
  <main class="teacher-guides-shell mx-auto grid max-w-[1440px] gap-6 px-4 py-6 sm:px-6 lg:grid-cols-[270px_minmax(0,1fr)] lg:gap-8 lg:px-8 lg:py-8">
    <aside class="teacher-guides-sidebar">
      <div class="mb-5"><a href="/admin" class="text-xs font-semibold text-accent-light hover:underline">← Painel administrativo</a><p class="mt-6 text-[10px] font-bold uppercase tracking-[.2em] text-accent-light">Área do professor</p><h1 class="mt-2 font-display text-2xl font-semibold">Guias de ensino</h1><p class="mt-2 text-sm leading-relaxed text-text-muted-light dark:text-text-muted-dark">Seus materiais de aula, organizados por disciplina e módulo.</p></div>
      {disciplines.map((discipline) => {
        const disciplineGuides = guides.filter((guide) => guide.discipline_slug === discipline.slug);
        return disciplineGuides.length > 0 && <section class="mb-5" aria-label={discipline.name}><h2 class="mb-2 px-2 text-[10px] font-bold uppercase tracking-[.15em] text-text-muted-light dark:text-text-muted-dark">{discipline.name}</h2><nav class="grid gap-1">{disciplineGuides.map((guide) => <a class:list={["guide-nav-item", { 'guide-nav-item-active': selectedGuide?.id === guide.id }]} href={`/professor/guias?guia=${guide.id}`} aria-current={selectedGuide?.id === guide.id ? 'page' : undefined}><span class="guide-nav-index">{String(modules.find((item) => item.id === guide.module_id)?.sort_order ?? 1).padStart(2, '0')}</span><span class="min-w-0"><strong>{guide.moduleName}</strong><small>{guide.page_count} páginas</small></span></a>)}</nav></section>;
      })}
      {guides.length === 0 && <p class="rounded-xl border border-dashed border-border-light p-4 text-sm text-text-muted-light dark:border-border-dark dark:text-text-muted-dark">Nenhum guia foi incluído ainda.</p>}
      <div class="teacher-guides-private"><span aria-hidden="true">▣</span><p>A biblioteca é privada e só aparece no seu login de professor.</p></div>
    </aside>

    <section class="teacher-guide-viewer" aria-label="Leitor de guia do professor">
      {selectedGuide ? <>
        <header class="teacher-guide-heading"><div class="min-w-0"><p class="text-[10px] font-bold uppercase tracking-[.18em] text-accent-light">{selectedGuide.disciplineName} <span class="mx-1 text-border-light">·</span> {selectedGuide.moduleName}</p><h2 class="mt-2 font-display text-xl font-semibold leading-snug sm:text-2xl">{selectedGuide.title}</h2><p class="mt-2 text-xs text-text-muted-light dark:text-text-muted-dark">PDF original · {selectedGuide.page_count} páginas</p></div>{signedUrl && <div class="guide-file-actions"><a href={signedUrl} target="_blank" rel="noreferrer" class="guide-file-button">Abrir em nova aba ↗</a><a href={signedUrl} download={selectedGuide.source_filename} class="guide-file-button guide-file-download">Baixar PDF ↓</a></div>}</header>
        {signedUrl ? <iframe class="teacher-guide-pdf" src={`${signedUrl}#toolbar=1&navpanes=0&view=FitH`} title={`Guia do professor: ${selectedGuide.title}`} loading="eager"></iframe> : <div class="teacher-guide-error" role="alert"><strong>Não foi possível abrir este guia.</strong><p>{viewerError ? 'Confira se o arquivo está no armazenamento privado do Supabase e tente novamente.' : 'Tente novamente em instantes.'}</p></div>}
      </> : <div class="teacher-guide-empty"><span aria-hidden="true">▤</span><p class="mt-4 text-[10px] font-bold uppercase tracking-[.18em] text-accent-light">Biblioteca de ensino</p><h2 class="mt-2 font-display text-2xl font-semibold">Seus guias ficarão aqui</h2><p class="mt-3 max-w-md text-sm leading-relaxed text-text-muted-light dark:text-text-muted-dark">Quando você enviar os próximos módulos, eles poderão ser adicionados a esta área sem misturar o material do professor com as apostilas dos alunos.</p></div>}
    </section>
  </main>
</BaseLayout>

<style>
  .teacher-guides-sidebar { min-width:0; }
  .guide-nav-item { display:flex; align-items:center; gap:10px; border:1px solid transparent; border-radius:13px; padding:10px; color:var(--color-text-main-light); transition:background .15s,border-color .15s; }
  .guide-nav-item:hover { background:color-mix(in srgb,var(--color-accent-light) 7%,transparent); }
  .guide-nav-item-active { border-color:color-mix(in srgb,var(--color-accent-light) 24%,var(--color-border-light)); background:color-mix(in srgb,var(--color-accent-light) 8%,transparent); }
  .guide-nav-index { display:grid; width:32px; height:32px; flex:none; place-items:center; border-radius:10px; background:color-mix(in srgb,var(--color-accent-light) 12%,transparent); color:var(--color-accent-light); font-family:'Orbitron',sans-serif; font-size:12px; font-weight:700; }
  .guide-nav-item > span:last-child { display:grid; min-width:0; gap:3px; }
  .guide-nav-item strong { overflow:hidden; font-size:12px; text-overflow:ellipsis; white-space:nowrap; }
  .guide-nav-item small { color:var(--color-text-muted-light); font-size:10px; }
  :global(.dark) .guide-nav-item { color:var(--color-text-main-dark); }
  :global(.dark) .guide-nav-item-active { border-color:color-mix(in srgb,var(--color-accent-dark) 25%,var(--color-border-dark)); }
  :global(.dark) .guide-nav-item small { color:var(--color-text-muted-dark); }
  .teacher-guides-private { display:flex; gap:10px; margin-top:24px; border:1px solid var(--color-border-light); border-radius:14px; padding:13px; color:var(--color-text-muted-light); font-size:11px; line-height:1.5; }
  .teacher-guides-private > span { color:var(--color-accent-light); font-size:15px; }
  :global(.dark) .teacher-guides-private { border-color:var(--color-border-dark); color:var(--color-text-muted-dark); }
  .teacher-guide-viewer { min-width:0; overflow:hidden; border:1px solid var(--color-border-light); border-radius:20px; background:var(--color-surface-light); }
  .teacher-guide-heading { display:flex; align-items:center; justify-content:space-between; gap:18px; border-bottom:1px solid var(--color-border-light); padding:18px 20px; }
  .guide-file-actions { display:flex; flex:none; flex-wrap:wrap; gap:8px; }
  .guide-file-button { display:inline-flex; align-items:center; justify-content:center; border:1px solid var(--color-border-light); border-radius:999px; padding:9px 12px; color:var(--color-text-main-light); font-size:11px; font-weight:700; transition:border-color .15s,color .15s; }
  .guide-file-button:hover { border-color:var(--color-accent-light); color:var(--color-accent-light); }
  .guide-file-download { border-color:var(--color-accent-light); background:var(--color-accent-light); color:white; }
  .teacher-guide-pdf { display:block; width:100%; height:min(78dvh,1100px); min-height:650px; border:0; background:#ece8de; }
  .teacher-guide-error,.teacher-guide-empty { display:grid; min-height:55vh; place-content:center; padding:32px; text-align:center; }
  .teacher-guide-error { color:#b91c1c; }
  .teacher-guide-error p { margin-top:8px; font-size:13px; }
  .teacher-guide-empty > span { font-size:40px; color:var(--color-accent-light); }
  :global(.dark) .teacher-guide-viewer { border-color:var(--color-border-dark); background:var(--color-surface-dark); }
  :global(.dark) .teacher-guide-heading { border-color:var(--color-border-dark); }
  :global(.dark) .guide-file-button { border-color:var(--color-border-dark); color:var(--color-text-main-dark); }
  :global(.dark) .guide-file-download { border-color:var(--color-accent-dark); background:var(--color-accent-dark); color:white; }
  @media(max-width:800px) { .teacher-guide-heading { align-items:flex-start; flex-direction:column; } .teacher-guide-pdf { height:75dvh; min-height:520px; } }
  @media(max-width:500px) { .teacher-guide-pdf { height:70dvh; min-height:450px; } .guide-file-actions { width:100%; } .guide-file-button { flex:1; } }
</style>
