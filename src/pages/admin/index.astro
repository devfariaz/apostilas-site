    const mList = $('#module-list'); mList.replaceChildren(); modules.filter((item) => { const parent = disciplines.find((d) => d.slug === item.discipline_slug); return `${item.name} ${item.slug} ${parent?.name ?? ''}`.toLocaleLowerCase('pt-BR').includes(moduleSearch) && (moduleDisciplineFilter === 'all' || item.discipline_slug === moduleDisciplineFilter); }).forEach((item) => { const parent = disciplines.find((d) => d.slug === item.discipline_slug); const row = document.createElement('div'); row.className = 'flex items-center gap-2 rounded-xl bg-black/[.03] p-3 dark:bg-white/[.04]'; const text = document.createElement('span'); text.className = 'min-w-0 flex-1 text-sm'; text.textContent = `${item.name} · ${parent?.name ?? item.discipline_slug}`; row.append(text, actionButton('Editar', () => editModule(item)), actionButton('Excluir', () => removeRow('modules', item, load), true)); mList.append(row); });
