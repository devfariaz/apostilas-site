    const sList = $('#student-list'); sList.replaceChildren(); document.querySelectorAll<HTMLButtonElement>('#student-filters [data-filter]').forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.filter === studentFilter))); const filteredStudents = getVisibleStudents(); filteredStudents.forEach((student) => { const isSelected = selectedStudentIds.has(student.id); const row = document.createElement('article'); row.className = `student-card rounded-2xl border p-4 transition ${isSelected ? 'is-selected' : 'border-border-light dark:border-border-dark'}`; const top = document.createElement('div'); top.className = 'flex items-start gap-3'; const select = document.createElement('input'); select.type = 'checkbox'; select.checked = isSelected; select.className = 'student-select mt-1'; select.setAttribute('aria-label', `Selecionar ${student.email}`); select.addEventListener('change', () => { select.checked ? selectedStudentIds.add(student.id) : selectedStudentIds.delete(student.id); renderLists(); updateBulkState(); }); const info = document.createElement('div'); info.className = 'min-w-0 flex-1'; const email = document.createElement('strong'); email.className = 'block truncate text-sm'; email.textContent = student.email; const meta = document.createElement('div'); meta.className = 'mt-1 flex flex-wrap items-center gap-2'; const name = document.createElement('span'); name.className = 'min-w-0 truncate text-xs text-text-muted-light dark:text-text-muted-dark'; name.textContent = `${student.full_name || 'Aluno'} · ${student.is_active ? 'ativo' : 'aguardando aprovação'}`; meta.append(name); const year = studentYear(student); const yearBadge = document.createElement('span'); yearBadge.className = year ? 'student-year-badge' : 'student-year-badge is-missing'; yearBadge.textContent = year ? `${year}º ano` : 'Ano não definido'; meta.append(yearBadge); info.append(email, meta); const assigned = document.createElement('div'); assigned.className = 'student-assigned mt-3'; const assignedHeading = document.createElement('span'); assignedHeading.className = 'student-assigned-heading'; assignedHeading.textContent = 'Disciplinas'; assigned.append(assignedHeading); const tags = document.createElement('div'); tags.className = 'mt-2 flex flex-wrap gap-1.5'; const assignedNames = (student.discipline_slugs ?? []).map((slug: string) => availableDisciplines.find((discipline) => discipline.slug === slug)?.name ?? slug); if (assignedNames.length) assignedNames.forEach((disciplineName: string) => { const tag = document.createElement('span'); tag.className = 'student-discipline-tag'; tag.textContent = disciplineName; tags.append(tag); }); else { const emptyAssignment = document.createElement('span'); emptyAssignment.className = 'text-xs text-text-muted-light dark:text-text-muted-dark'; emptyAssignment.textContent = 'Nenhuma disciplina atribuída'; tags.append(emptyAssignment); } assigned.append(tags); info.append(assigned); const action = actionButton(student.is_active ? 'Revogar' : 'Aprovar', async () => { try { await api('/api/admin/students', 'PUT', { id: student.id, is_active: !student.is_active }); await load(); } catch (error) { alert(error instanceof Error ? error.message : 'Não foi possível atualizar o aluno.'); } }, student.is_active); top.append(select, info, action); row.append(top); const editAssignment = actionButton('Editar ano e disciplinas', () => openStudentEdit(student)); editAssignment.className = 'student-edit-action'; row.append(editAssignment); sList.append(row); });
    $('#selection-count').textContent = String(selectedStudentIds.size);
    if (!students.length) { const empty = document.createElement('p'); empty.className = 'text-sm text-text-muted-light dark:text-text-muted-dark'; empty.textContent = 'Nenhum aluno cadastrado ainda.'; sList.append(empty); }
  }
  const yearDisciplineDefaults: Record<string, string[]> = { '1': ['game-design-i','producao-multimidia-i'], '2': ['game-design-ii','producao-multimidia-ii'], '3': ['marketing','game-design-iii','producao-multimidia-iii'] };
  function studentYear(student: Row): number | null {
    const savedYear = Number(student.year_level);
    // O ano letivo é um dado independente das disciplinas atribuídas.
    return Number.isInteger(savedYear) && savedYear >= 1 && savedYear <= 3 ? savedYear : null;
  }
  function studentMissingAssignment(student: Row) { return !studentYear(student) || !Array.isArray(student.discipline_slugs) || student.discipline_slugs.length === 0; }
  function getVisibleStudents() {
    return students.filter((student) => {
      const matchesFilter = studentFilter === 'all'
        || (studentFilter === 'rm' && student.email.toLowerCase().startsWith('rm'))
        || (studentFilter === 'pending' && !student.is_active)
        || (studentFilter === 'missing-assignment' && studentMissingAssignment(student))
