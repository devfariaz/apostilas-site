  $('#lesson-form [name="discipline_slug"]').addEventListener('change', updateModuleOptions);
  document.querySelectorAll<HTMLButtonElement>('#student-filters [data-filter]').forEach((button) => button.addEventListener('click', () => { studentFilter = button.dataset.filter ?? 'all'; renderLists(); }));
  $('#select-visible').addEventListener('click', () => { const visible = getVisibleStudents(); visible.forEach((student) => selectedStudentIds.add(student.id)); renderLists(); $('#bulk-help').textContent = `${visible.length} aluno(s) visível(is) selecionado(s).`; updateBulkState(); });
  $('#clear-selection').addEventListener('click', () => { selectedStudentIds.clear(); renderLists(); $('#bulk-help').textContent = 'Seleção limpa. Escolha alunos pelas caixas ou importe uma lista.'; updateBulkState(); });
  $('#student-search').addEventListener('input', (event) => { studentSearch = (event.currentTarget as HTMLInputElement).value.toLocaleLowerCase('pt-BR').trim(); renderLists(); });
  $('#import-emails').addEventListener('click', () => {
    const raw = ($('#student-email-import') as HTMLTextAreaElement).value;
    // Colunas do Excel podem vir com aspas, ponto e vírgula, cabeçalhos ou texto adicional.
    // Extraímos os endereços completos e comparamos em formato normalizado.
    const emails = [...new Set((raw.match(/[a-z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+/gi) ?? []).map((email) => email.trim().replace(/[.,;:]+$/, '').toLocaleLowerCase('pt-BR')))];
    const emailKey = (value: unknown) => String(value ?? '').trim().replace(/^['"\s]+|['"\s]+$/g, '').toLocaleLowerCase('pt-BR');
    const byEmail = new Map(students.map((student) => [emailKey(student.email), student.id]));
    const found = new Set(emails.flatMap((email) => byEmail.has(email) ? [byEmail.get(email)!] : []));
    selectedStudentIds.clear(); found.forEach((id) => selectedStudentIds.add(id));
    const missing = emails.filter((email) => !byEmail.has(email));
    studentFilter = 'all'; studentSearch = '';
    ($('#student-search') as HTMLInputElement).value = '';
    renderLists();
    const help = $('#bulk-help');
    help.textContent = emails.length
      ? `${found.size} de ${emails.length} e-mail(s) encontrado(s) e selecionado(s).${missing.length ? ` Não encontrados: ${missing.join(', ')}` : ''}`
      : 'Não encontrei endereços de e-mail no texto colado. Cole uma coluna de e-mails e tente novamente.';
    updateBulkState();
  });
  $('#bulk-year').addEventListener('change', updateBulkState);
  $('#bulk-assign').addEventListener('click', async () => { const year = ($('#bulk-year') as HTMLSelectElement).value; if (!year) { $('#bulk-help').textContent = 'Selecione o ano antes de vincular.'; return; } if (!selectedStudentIds.size) { $('#bulk-help').textContent = 'Selecione alunos nos cartões ou cole os e-mails do Excel.'; return; } const count = selectedStudentIds.size; const button = $('#bulk-assign') as HTMLButtonElement; button.disabled = true; button.textContent = 'Salvando vínculos…'; try { await api('/api/admin/students', 'PUT', { student_ids: [...selectedStudentIds], year_level: Number(year), discipline_slugs: yearDisciplineDefaults[year] }); selectedStudentIds.clear(); await load(); updateBulkState(); $('#bulk-help').textContent = `${count} aluno(s) vinculado(s) ao ${year}º ano. Ano e disciplinas foram recarregados do banco.`; } catch (error) { $('#bulk-help').textContent = error instanceof Error ? error.message : 'Não foi possível vincular os alunos.'; } finally { button.textContent = 'Atribuir ano e disciplinas'; updateBulkState(); } });

  $('#student-edit-year').addEventListener('change', (event) => { const year = (event.currentTarget as HTMLSelectElement).value; const preset = yearDisciplineDefaults[year]; if (!preset) return; $('#student-edit-disciplines').querySelectorAll<HTMLInputElement>('input[type="checkbox"]').forEach((checkbox) => { checkbox.checked = preset.includes(checkbox.value); }); });
  $('#student-edit-save').addEventListener('click', async () => { if (!editingStudent) return; const button = $('#student-edit-save') as HTMLButtonElement; const year = ($('#student-edit-year') as HTMLSelectElement).value; const discipline_slugs = [...$('#student-edit-disciplines').querySelectorAll<HTMLInputElement>('input:checked')].map((input) => input.value); button.disabled = true; button.textContent = 'Salvando…'; try { await api('/api/admin/students', 'PUT', { id: editingStudent.id, year_level: year ? Number(year) : null, discipline_slugs }); $('#student-edit-dialog').close(); await load(); } catch (error) { alert(error instanceof Error ? error.message : 'Não foi possível salvar o vínculo.'); } finally { button.disabled = false; button.textContent = 'Salvar vínculo'; } });
  document.querySelectorAll<HTMLButtonElement>('[data-new]').forEach((button) => button.addEventListener('click', () => { const dialog = document.getElementById(button.dataset.new!) as HTMLDialogElement; const form = dialog.querySelector('form')!; form.reset(); (form.elements.namedItem('id') as HTMLInputElement).value = ''; if (form.id === 'lesson-form') updateModuleOptions(); dialog.showModal(); }));
  document.querySelectorAll<HTMLButtonElement>('[data-close-dialog]').forEach((button) => button.addEventListener('click', () => button.closest('dialog')?.close()));
  document.querySelectorAll<HTMLDialogElement>('.admin-dialog').forEach((dialog) => dialog.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); }));
  $('#lesson-select-visible').addEventListener('click', () => { const visible = [...$('#lesson-list').querySelectorAll<HTMLInputElement>('input[type=checkbox]')]; visible.forEach((checkbox) => { checkbox.checked = true; const id = checkbox.dataset.lessonId; if (id) selectedLessonIds.add(id); }); renderLists(); $('#lesson-bulk-status').textContent = `${visible.length} capítulo(s) nos resultados filtrados selecionado(s).`; });
  $('#lesson-clear-selection').addEventListener('click', () => { selectedLessonIds.clear(); renderLists(); $('#lesson-bulk-status').textContent = 'Seleção limpa.'; });
  $('#lesson-bulk-delete').addEventListener('click', async () => { const ids = [...selectedLessonIds]; if (!ids.length) return; if (!confirm(`Excluir ${ids.length} capítulo(s) selecionado(s)? Esta ação não pode ser desfeita.`)) return; const button = $('#lesson-bulk-delete') as HTMLButtonElement; button.disabled = true; button.textContent = 'Excluindo…'; try { const result = await api('/api/admin/apostilas', 'DELETE', { ids }); selectedLessonIds.clear(); $('#lesson-bulk-status').textContent = `${result.deletedCount ?? ids.length} capítulo(s) excluído(s).`; await load(); } catch (error) { $('#lesson-bulk-status').textContent = error instanceof Error ? error.message : 'Não foi possível excluir os capítulos.'; } finally { button.textContent = 'Excluir selecionados'; updateLessonSelection(); } });
  $('#discipline-search').addEventListener('input', (event) => { disciplineSearch = (event.currentTarget as HTMLInputElement).value.toLocaleLowerCase('pt-BR').trim(); renderLists(); });
  $('#discipline-active-filter').addEventListener('change', renderLists);
  $('#module-search').addEventListener('input', (event) => { moduleSearch = (event.currentTarget as HTMLInputElement).value.toLocaleLowerCase('pt-BR').trim(); renderLists(); });
  $('#module-discipline-filter').addEventListener('change', (event) => { moduleDisciplineFilter = (event.currentTarget as HTMLSelectElement).value; renderLists(); });
  $('#lesson-search').addEventListener('input', (event) => { lessonSearch = (event.currentTarget as HTMLInputElement).value.toLocaleLowerCase('pt-BR').trim(); renderLists(); });
  $('#lesson-discipline-filter').addEventListener('change', (event) => { lessonDisciplineFilter = (event.currentTarget as HTMLSelectElement).value; lessonModuleFilter = 'all'; const moduleFilter = $('#lesson-module-filter') as HTMLSelectElement; fillSelect(moduleFilter, modules.filter((row) => lessonDisciplineFilter === 'all' || row.discipline_slug === lessonDisciplineFilter), (row) => row.name, (row) => row.id, 'Todos os módulos'); if (moduleFilter.options[0]) moduleFilter.options[0].value = 'all'; moduleFilter.value = 'all'; renderLists(); });
  $('#lesson-module-filter').addEventListener('change', (event) => { lessonModuleFilter = (event.currentTarget as HTMLSelectElement).value; renderLists(); });
  $('#lesson-status-filter').addEventListener('change', (event) => { lessonStatusFilter = (event.currentTarget as HTMLSelectElement).value; renderLists(); });
  await load(); updateBulkState();
</script>
