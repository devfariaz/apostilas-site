---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { createSupabaseServerClient } from '../../lib/supabase';
export const prerender = false;
const supabase = createSupabaseServerClient(Astro.cookies, Astro.request);
const { data: { user } } = await supabase.auth.getUser();
---
<BaseLayout title="Painel administrativo — Professor Deivid Nobre - Apostilas" user={user}>
  <main class="mx-auto max-w-7xl px-5 py-10 lg:px-8">
    <p class="text-xs font-bold uppercase tracking-[.2em] text-accent-light">Gestão de conteúdo</p><h1 class="mt-2 font-display text-4xl font-semibold">Painel administrativo</h1><p class="mt-3 text-text-muted-light dark:text-text-muted-dark">Cadastre disciplinas, organize módulos e publique capítulos da apostila.</p>
    <nav class="admin-tabs mt-8" role="tablist" aria-label="Seções administrativas">
      <button id="tab-disciplines" class="admin-tab" type="button" role="tab" aria-selected="true" aria-controls="panel-disciplines" tabindex="0"><span>01</span>Disciplinas</button>
      <button id="tab-modules" class="admin-tab" type="button" role="tab" aria-selected="false" aria-controls="panel-modules" tabindex="-1"><span>02</span>Módulos</button>
      <button id="tab-lessons" class="admin-tab" type="button" role="tab" aria-selected="false" aria-controls="panel-lessons" tabindex="-1"><span>03</span>Capítulos</button>
      <button id="tab-students" class="admin-tab" type="button" role="tab" aria-selected="false" aria-controls="panel-students" tabindex="-1"><span>04</span>Aprovações</button>
    </nav>
    <div class="mt-6">
      <section id="panel-disciplines" class="admin-panel max-w-3xl rounded-3xl border border-border-light bg-surface-light p-6 dark:border-border-dark dark:bg-surface-dark" role="tabpanel" aria-labelledby="tab-disciplines" tabindex="0">
        <p class="text-xs font-bold uppercase tracking-[.18em] text-accent-light">Organize por área de estudo</p>
        <div class="flex flex-wrap items-center justify-between gap-3"><h2 class="font-display text-2xl font-semibold">Disciplinas</h2><button type="button" class="admin-primary" data-new="discipline-dialog">＋ Nova disciplina</button></div><div class="admin-list-filters"><input id="discipline-search" class="admin-input" placeholder="Buscar disciplina…" aria-label="Buscar disciplina" /><select id="discipline-active-filter" class="admin-input"><option value="all">Todas</option><option value="active">Visíveis</option><option value="inactive">Ocultas</option></select></div><dialog id="discipline-dialog" class="admin-dialog"><div class="admin-dialog-head"><div><p class="text-xs font-bold uppercase tracking-widest text-accent-light">Cadastro</p><h3 class="mt-1 font-display text-2xl font-semibold">Disciplina</h3></div><button type="button" class="admin-close" data-close-dialog aria-label="Fechar">✕</button></div><form id="discipline-form" class="mt-5 space-y-3"><input type="hidden" name="id" /><label class="block text-sm">Nome<input required name="name" class="admin-input" placeholder="Ex.: Game Design I" /></label><label class="block text-sm">Slug<input name="slug" class="admin-input" placeholder="game-design-i (gerado se vazio)" /></label><label class="block text-sm">Apresentação da disciplina<textarea name="description" rows="4" class="admin-input" placeholder="Apresente a disciplina e o que o aluno vai estudar."></textarea></label><label class="block text-sm">Habilidades desenvolvidas<textarea name="skills" rows="4" class="admin-input" placeholder="Uma habilidade por linha. Ex.: Criar protótipos interativos."></textarea><span class="mt-1 block text-xs text-text-muted-light dark:text-text-muted-dark">Uma habilidade por linha.</span></label><label class="block text-sm">Competências adquiridas<textarea name="competencies" rows="4" class="admin-input" placeholder="Uma competência por linha. Ex.: Planejar e avaliar soluções de design."></textarea><span class="mt-1 block text-xs text-text-muted-light dark:text-text-muted-dark">Uma competência por linha.</span></label><label class="block text-sm">Ordem<input type="number" min="0" name="sort_order" value="0" class="admin-input" /></label><label class="flex items-center gap-2 text-sm"><input type="checkbox" name="active" checked /> Visível no site</label><div class="flex gap-2"><button class="admin-primary">Salvar disciplina</button><button type="button" class="admin-secondary" data-reset="discipline-form">Limpar</button></div></form><p id="discipline-status" class="mt-3 text-sm" aria-live="polite"></p></dialog><div id="discipline-list" class="mt-5 space-y-2"></div>
      </section>
      <section id="panel-modules" class="admin-panel max-w-3xl rounded-3xl border border-border-light bg-surface-light p-6 dark:border-border-dark dark:bg-surface-dark" role="tabpanel" aria-labelledby="tab-modules" tabindex="0" hidden>
        <p class="text-xs font-bold uppercase tracking-[.18em] text-accent-light">Agrupe o conteúdo</p>
        <div class="flex flex-wrap items-center justify-between gap-3"><h2 class="font-display text-2xl font-semibold">Módulos</h2><button type="button" class="admin-primary" data-new="module-dialog">＋ Novo módulo</button></div><div class="admin-list-filters"><input id="module-search" class="admin-input" placeholder="Buscar módulo…" aria-label="Buscar módulo" /><select id="module-discipline-filter" class="admin-input"><option value="all">Todas as disciplinas</option></select></div><dialog id="module-dialog" class="admin-dialog"><div class="admin-dialog-head"><div><p class="text-xs font-bold uppercase tracking-widest text-accent-light">Cadastro</p><h3 class="mt-1 font-display text-2xl font-semibold">Módulo</h3></div><button type="button" class="admin-close" data-close-dialog aria-label="Fechar">✕</button></div><form id="module-form" class="mt-5 space-y-3"><input type="hidden" name="id" /><label class="block text-sm">Disciplina<select required name="discipline_slug" class="admin-input"></select></label><label class="block text-sm">Nome do módulo<input required name="name" class="admin-input" placeholder="Ex.: Fundamentos" /></label><label class="block text-sm">Slug<input name="slug" class="admin-input" placeholder="fundamentos (gerado se vazio)" /></label><label class="block text-sm">Ordem<input type="number" min="0" name="sort_order" value="0" class="admin-input" /></label><div class="flex gap-2"><button class="admin-primary">Salvar módulo</button><button type="button" class="admin-secondary" data-reset="module-form">Limpar</button></div></form><p id="module-status" class="mt-3 text-sm" aria-live="polite"></p></dialog><div id="module-list" class="mt-5 space-y-2"></div>
      </section>
      <section id="panel-lessons" class="admin-panel rounded-3xl border border-border-light bg-surface-light p-6 dark:border-border-dark dark:bg-surface-dark" role="tabpanel" aria-labelledby="tab-lessons" tabindex="0" hidden>
        <p class="text-xs font-bold uppercase tracking-[.18em] text-accent-light">Escreva e publique</p>
        <div class="flex flex-wrap items-center justify-between gap-3"><h2 class="font-display text-2xl font-semibold">Capítulos</h2><button type="button" class="admin-primary" data-new="lesson-dialog">＋ Novo capítulo</button></div><p class="mt-2 text-sm text-text-muted-light dark:text-text-muted-dark">Monte a leitura por blocos. A aula e a prática guiada aparecem em guias separadas para o aluno.</p><div class="admin-list-filters"><input id="lesson-search" class="admin-input" placeholder="Buscar capítulo, tag ou módulo…" aria-label="Buscar capítulo" /><select id="lesson-discipline-filter" class="admin-input"><option value="all">Todas as disciplinas</option></select><select id="lesson-module-filter" class="admin-input"><option value="all">Todos os módulos</option></select><select id="lesson-status-filter" class="admin-input"><option value="all">Publicados e rascunhos</option><option value="published">Publicados</option><option value="draft">Rascunhos</option></select></div><div class="lesson-bulk-toolbar" aria-label="Ações em massa para capítulos"><div><strong><span id="lesson-selection-count">0</span> selecionados</strong><p id="lesson-bulk-status" aria-live="polite">Selecione capítulos ou todos os resultados filtrados.</p></div><div class="flex flex-wrap gap-2"><button id="lesson-select-visible" type="button" class="admin-secondary">Selecionar resultados</button><button id="lesson-clear-selection" type="button" class="admin-secondary">Limpar seleção</button><button id="lesson-bulk-delete" type="button" class="admin-danger" disabled>Excluir selecionados</button></div></div><dialog id="lesson-dialog" class="admin-dialog"><div class="admin-dialog-head"><div><p class="text-xs font-bold uppercase tracking-widest text-accent-light">Cadastro</p><h3 class="mt-1 font-display text-2xl font-semibold">Capítulo</h3></div><button type="button" class="admin-close" data-close-dialog aria-label="Fechar">✕</button></div><form id="lesson-form" class="mt-5 grid gap-3 md:grid-cols-2"><input type="hidden" name="id" /><label class="block text-sm">Disciplina<select required name="discipline_slug" class="admin-input"></select></label><label class="block text-sm">Módulo<select name="module_id" class="admin-input"></select></label><label class="block text-sm">Título do capítulo<input required name="title" class="admin-input" /></label><label class="block text-sm">Slug<input name="slug" class="admin-input" placeholder="gerado a partir do título" /></label><label class="block text-sm md:col-span-2">Apresentação / resumo<textarea name="summary" rows="2" class="admin-input" placeholder="Texto de abertura exibido no topo do capítulo"></textarea></label><label class="block text-sm">Tags para pesquisa<input name="tags" class="admin-input" placeholder="vetor, formas, illustrator" /><span class="mt-1 block text-xs text-text-muted-light dark:text-text-muted-dark">Separe por vírgulas. Cada tag vira um filtro clicável na apostila.</span></label><label class="block text-sm">Ordem no módulo<input type="number" min="0" name="lesson_order" value="0" class="admin-input" /></label><label class="block text-sm">Tempo de leitura (minutos)<input type="number" min="1" max="999" name="reading_minutes" value="10" class="admin-input" /></label><label class="block text-sm">Nível<input name="difficulty" value="Introdutório" class="admin-input" placeholder="Introdutório" /></label><label class="block text-sm md:col-span-2">Ideia-chave<textarea name="key_idea" rows="2" class="admin-input" placeholder="Uma frase em destaque para fixar o conceito"></textarea></label><label class="block text-sm md:col-span-2">Atalhos de teclado (um por linha: teclas | ferramenta)<textarea name="shortcuts_text" rows="3" class="admin-input font-mono text-sm" placeholder="Shift + M | Construtor de Formas&#10;Alt | Subtrair áreas&#10;Shift | Proporção perfeita"></textarea><span class="mt-1 block text-xs text-text-muted-light dark:text-text-muted-dark">Exemplo: Shift + M | Construtor de Formas. Você pode cadastrar vários atalhos.</span></label><label class="block text-sm md:col-span-2">O essencial (um item por linha, no formato Título | explicação)<textarea name="essential_points" rows="4" class="admin-input" placeholder="Ponto + linha | A semente parada e seu rastro em movimento.&#10;Filosofia Lego | Construa com blocos antes de detalhar."></textarea></label><label class="block text-sm md:col-span-2">Aula (Markdown)<textarea required name="body_markdown" rows="14" class="admin-input font-mono text-xs" placeholder="# Seções da aula&#10;&#10;Use ## para criar um tópico. Para dica: > DICA: escreva a dica. Para comparativo visual: use tabelas ou imagens do Markdown."></textarea></label><label class="block text-sm md:col-span-2">Prática guiada (Markdown)<textarea name="practice_markdown" rows="12" class="admin-input font-mono text-xs" placeholder="# Título da prática&#10;&#10;## 01 Preparando a prancheta&#10;1. Abra o aplicativo.&#10;2. Configure o documento.&#10;&#10;> DICA: uma observação útil para esta etapa."></textarea></label><label class="flex items-center gap-2 text-sm"><input type="checkbox" name="published" checked /> Publicado</label><div class="flex gap-2"><button class="admin-primary">Salvar capítulo</button><button type="button" class="admin-secondary" data-reset="lesson-form">Novo capítulo</button></div></form><p id="lesson-status" class="mt-3 text-sm" aria-live="polite"></p></dialog><div id="lesson-list" class="mt-5 space-y-2"></div>
      </section>
    </div>
    <section id="panel-students" class="admin-panel rounded-3xl border border-border-light bg-surface-light p-6 dark:border-border-dark dark:bg-surface-dark" role="tabpanel" aria-labelledby="tab-students" tabindex="0" hidden><div class="flex flex-wrap items-end justify-between gap-3"><div><p class="text-xs font-bold uppercase tracking-[.2em] text-accent-light">Acesso de alunos</p><h2 class="mt-1 font-display text-2xl font-semibold">Aprovações e disciplinas</h2></div><p class="text-sm text-text-muted-light dark:text-text-muted-dark">Contas com prefixo <strong>rm</strong> são ativadas automaticamente.</p></div>
      <section class="bulk-panel mt-6" aria-label="Atribuição em massa de alunos">
        <div class="flex flex-wrap items-start justify-between gap-3"><div><p class="text-xs font-bold uppercase tracking-widest text-accent-light">Atribuição em massa</p><h3 class="mt-1 font-display text-xl font-semibold">Vincule uma turma de uma vez</h3><p class="mt-1 text-sm text-text-muted-light dark:text-text-muted-dark">Cole os e-mails da planilha e aplique o ano para atribuir as disciplinas automaticamente.</p></div><span class="bulk-selection-count"><strong id="selection-count">0</strong> selecionados</span></div>
        <div class="mt-5 grid gap-4 lg:grid-cols-[1.2fr_.8fr]">
          <div class="bulk-step"><div class="bulk-step-title"><span>1</span><div><strong>Cole os e-mails</strong><small>Uma linha por aluno. E-mails separados por vírgula também funcionam.</small></div></div><textarea id="student-email-import" class="admin-input" rows="4" placeholder="rm12345@instituicao.com.br&#10;rm67890@instituicao.com.br"></textarea><button id="import-emails" type="button" class="admin-secondary mt-3 w-full">Localizar alunos da lista</button></div>
          <div class="bulk-step"><div class="bulk-step-title"><span>2</span><div><strong>Escolha o ano</strong><small>As disciplinas são preenchidas conforme o ano.</small></div></div><label class="mt-4 block text-xs font-semibold" for="bulk-year">Ano da turma<select id="bulk-year" class="admin-input"><option value="">Selecione o ano</option><option value="1">1º ano</option><option value="2">2º ano</option><option value="3">3º ano</option></select></label><div id="bulk-preview" class="mt-3 rounded-xl bg-black/[.03] p-3 text-xs text-text-muted-light dark:bg-white/[.04] dark:text-text-muted-dark">Selecione um ano para ver as disciplinas vinculadas.</div><button id="bulk-assign" type="button" class="admin-primary mt-3 w-full" disabled>Atribuir ano e disciplinas</button></div>
        </div><p id="bulk-help" class="mt-3 text-sm text-text-muted-light dark:text-text-muted-dark" aria-live="polite">A atribuição será aplicada às contas encontradas e selecionadas.</p>
      </section>
      <div class="student-list-toolbar mt-6"><div><p class="text-xs font-bold uppercase tracking-widest text-accent-light">Contas cadastradas</p><h3 class="mt-1 font-display text-xl font-semibold">Alunos</h3></div><input id="student-search" class="admin-input" placeholder="Buscar por nome ou e-mail…" aria-label="Buscar alunos" /></div>
      <div class="mt-4 flex flex-wrap gap-2" id="student-filters" aria-label="Filtrar alunos"><button type="button" data-filter="all" class="admin-filter">Todos</button><button type="button" data-filter="rm" class="admin-filter">RM</button><button type="button" data-filter="pending" class="admin-filter">Aguardando aprovação</button><button type="button" data-filter="missing-assignment" class="admin-filter">Sem ano ou disciplinas</button><button type="button" data-filter="year-1" class="admin-filter">1º ano</button><button type="button" data-filter="year-2" class="admin-filter">2º ano</button><button type="button" data-filter="year-3" class="admin-filter">3º ano</button><button id="select-visible" type="button" class="admin-filter">Selecionar visíveis</button><button id="clear-selection" type="button" class="admin-filter">Limpar seleção</button></div>
      <p id="students-status" class="mt-3 text-sm" aria-live="polite"></p><div id="student-list" class="mt-4 grid gap-3 md:grid-cols-2 xl:grid-cols-3"></div>
      <dialog id="student-edit-dialog" class="admin-dialog student-edit-dialog"><div class="admin-dialog-head"><div><p class="text-xs font-bold uppercase tracking-widest text-accent-light">Editar aluno</p><h3 id="student-edit-name" class="mt-1 font-display text-2xl font-semibold">Vínculo escolar</h3><p id="student-edit-email" class="mt-1 text-sm text-text-muted-light dark:text-text-muted-dark"></p></div><button type="button" class="admin-close" data-close-dialog aria-label="Fechar">✕</button></div><label class="mt-5 block text-sm font-semibold" for="student-edit-year">Ano escolar<select id="student-edit-year" class="admin-input"><option value="">Selecione o ano</option><option value="1">1º ano</option><option value="2">2º ano</option><option value="3">3º ano</option></select></label><p class="mt-4 text-sm font-semibold">Disciplinas autorizadas</p><p class="mt-1 text-xs text-text-muted-light dark:text-text-muted-dark">Ao trocar o ano, as disciplinas sugeridas são atualizadas. Você pode ajustar a seleção.</p><div id="student-edit-disciplines" class="mt-3 grid gap-2 sm:grid-cols-2"></div><div class="mt-5 flex justify-end gap-2"><button type="button" class="admin-secondary" data-close-dialog>Cancelar</button><button type="button" id="student-edit-save" class="admin-primary">Salvar vínculo</button></div></dialog></section>
  </main>
</BaseLayout>
<style>
  .bulk-panel { border:1px solid #e5e0d8; border-radius:22px; padding:1.25rem; background:color-mix(in srgb,var(--color-accent-light) 3%,white); }
  :global(.dark) .bulk-panel { border-color:#2a2a2e; background:color-mix(in srgb,var(--color-accent-light) 6%,#1e1e22); }
  .bulk-step { border:1px solid #e5e0d8; border-radius:18px; padding:1rem; background:#fff; }
  :global(.dark) .bulk-step { border-color:#2a2a2e; background:#1e1e22; }
  .bulk-step-title { display:flex; align-items:flex-start; gap:.75rem; }
  :global(.student-card.is-selected) { border-color:var(--color-accent-light); background:color-mix(in srgb,var(--color-accent-light) 8%,white); box-shadow:0 0 0 2px color-mix(in srgb,var(--color-accent-light) 18%,transparent); }
  :global(.dark .student-card.is-selected) { background:color-mix(in srgb,var(--color-accent-light) 13%,#1e1e22); }
  :global(.student-select) { width:1.15rem; height:1.15rem; flex:none; accent-color:var(--color-accent-light); cursor:pointer; }
  :global(.student-year-badge) { display:inline-flex; align-items:center; border-radius:9999px; background:#e5f5f8; padding:.15rem .45rem; color:#087f99; font-size:.64rem; font-weight:800; line-height:1.2; white-space:nowrap; }
  :global(.student-year-badge.is-missing) { background:#f3f1ed; color:#827d74; }
  :global(.dark .student-year-badge) { background:color-mix(in srgb,var(--color-accent-light) 18%,#1e1e22); color:var(--color-accent-light); }
  :global(.dark .student-year-badge.is-missing) { background:#2a2a2e; color:#a1a1aa; }
  :global(.student-assigned) { border-top:1px solid color-mix(in srgb,var(--color-border-light) 75%,transparent); padding-top:.55rem; }
  :global(.dark .student-assigned) { border-color:var(--color-border-dark); }
  :global(.student-assigned-heading) { display:block; color:var(--color-text-muted-light); font-size:.59rem; font-weight:700; letter-spacing:.08em; text-transform:uppercase; }
  :global(.dark .student-assigned-heading) { color:var(--color-text-muted-dark); }
  :global(.student-discipline-tag) { display:inline-flex; align-items:center; border:1px solid color-mix(in srgb,var(--color-accent-light) 28%,transparent); border-radius:9999px; background:color-mix(in srgb,var(--color-accent-light) 10%,white); padding:.22rem .5rem; color:var(--color-accent-light); font-size:.66rem; font-weight:700; line-height:1.2; }
  :global(.dark .student-discipline-tag) { background:color-mix(in srgb,var(--color-accent-light) 15%,#1e1e22); }
  .bulk-step-title>span { display:grid; width:1.8rem; height:1.8rem; flex:none; place-items:center; border-radius:999px; background:var(--color-accent-light); color:white; font-size:.8rem; font-weight:700; }
  .bulk-step-title strong,.bulk-step-title small { display:block; }
  .bulk-step-title small { margin-top:.2rem; color:#777; font-size:.72rem; line-height:1.45; }
  .bulk-selection-count { border-radius:999px; background:color-mix(in srgb,var(--color-accent-light) 10%,white); padding:.45rem .8rem; color:var(--color-accent-light); font-size:.75rem; }
  .bulk-selection-count strong { font-size:.9rem; }
  .student-list-toolbar { display:flex; flex-wrap:wrap; align-items:end; justify-content:space-between; gap:1rem; }
  .student-list-toolbar .admin-input { width:min(100%,22rem); margin:0; }
  :global(.student-edit-action) { display:flex; min-height:2.75rem; margin-top:1rem; width:100%; align-items:center; justify-content:center; gap:.5rem; border:1px solid color-mix(in srgb,var(--color-accent-light) 42%,#ded9d0); border-radius:14px; padding:.7rem 1rem; background:color-mix(in srgb,var(--color-accent-light) 8%,white); color:var(--color-accent-light); font-size:.78rem; font-weight:700; box-shadow:0 2px 6px #0000000a; transition:transform .18s,background .18s,border-color .18s,box-shadow .18s; }
  :global(.student-edit-action::before) { content:'✎'; display:grid; width:1.35rem; height:1.35rem; place-items:center; border-radius:999px; background:color-mix(in srgb,var(--color-accent-light) 14%,white); font-size:.72rem; }
  :global(.student-edit-action:hover) { transform:translateY(-1px); border-color:var(--color-accent-light); background:color-mix(in srgb,var(--color-accent-light) 13%,white); box-shadow:0 5px 12px color-mix(in srgb,var(--color-accent-light) 12%,transparent); }
  :global(.dark .student-edit-action) { border-color:color-mix(in srgb,var(--color-accent-light) 45%,#38383d); background:color-mix(in srgb,var(--color-accent-light) 10%,#19191d); }
  :global(.dark .student-edit-action::before) { background:color-mix(in srgb,var(--color-accent-light) 18%,#19191d); }
  :global(.dark .student-edit-action:hover) { background:color-mix(in srgb,var(--color-accent-light) 18%,#19191d); }
  .student-edit-dialog { width:min(620px,calc(100vw - 2rem)); }
  #bulk-assign:disabled { cursor:not-allowed; opacity:.45; box-shadow:none; transform:none; }
  .admin-dialog { position:fixed; inset:0; margin:auto; width:min(900px,calc(100vw - 2rem)); max-height:calc(100dvh - 2rem); overflow:auto; border:1px solid #e5e0d8; border-radius:24px; padding:1.5rem; background:#fff; color:#1e1e1e; box-shadow:0 24px 80px #0003; }
  .admin-dialog::backdrop { background:#11182799; backdrop-filter:blur(4px); }
  :global(.dark) .admin-dialog { border-color:#2a2a2e; background:#1e1e22; color:#ededed; }
  .admin-dialog-head { display:flex; align-items:center; justify-content:space-between; gap:1rem; }
  .admin-close { display:grid; width:2.5rem; height:2.5rem; place-items:center; border:1px solid #e5e0d8; border-radius:999px; }
  .admin-list-filters { display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,190px),1fr)); gap:.65rem; margin-top:1rem; }
  .admin-list-filters .admin-input { margin-top:0; }
  .admin-input { display:block; width:100%; margin-top:.45rem; border:1px solid #ded9d0; border-radius:14px; padding:.78rem .9rem; background:#fff; color:#1e1e1e; box-shadow:0 1px 2px #1e1e1e08; transition:border-color .18s,box-shadow .18s,background .18s; }
  .admin-input::placeholder { color:#99958e; }
