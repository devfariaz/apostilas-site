  });
  const disciplines: Row[] = []; const modules: Row[] = []; const lessons: Row[] = []; const students: Row[] = []; let availableDisciplines: Row[] = []; let studentFilter = 'all'; let disciplineSearch = ''; let moduleSearch = ''; let moduleDisciplineFilter = 'all'; let lessonSearch = ''; let lessonDisciplineFilter = 'all'; let lessonModuleFilter = 'all'; let lessonStatusFilter = 'all'; let studentSearch = ''; let editingStudent: Row | null = null; const selectedStudentIds = new Set<string>(); const selectedLessonIds = new Set<string>();
  const slugify = (value: string) => value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
