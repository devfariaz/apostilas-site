      return matchesFilter && `${student.email} ${student.full_name ?? ''}`.toLocaleLowerCase('pt-BR').includes(studentSearch);
    });
  }
  function updateBulkState() { const year = ($('#bulk-year') as HTMLSelectElement).value; const button = $('#bulk-assign') as HTMLButtonElement; button.disabled = !year || selectedStudentIds.size === 0; $('#selection-count').textContent = String(selectedStudentIds.size); const preview = $('#bulk-preview'); if (!year) { preview.textContent = 'Selecione um ano para ver as disciplinas vinculadas.'; return; } const names = yearDisciplineDefaults[year].map((slug) => availableDisciplines.find((discipline) => discipline.slug === slug)?.name ?? slug); preview.textContent = `Serão atribuídas: ${names.join(' · ')}.`; }
  function openStudentEdit(student: Row) { editingStudent = student; $('#student-edit-name').textContent = student.full_name || 'Vínculo escolar'; $('#student-edit-email').textContent = student.email; const year = $('#student-edit-year') as HTMLSelectElement; const inferredYear = studentYear(student); year.value = inferredYear ? String(inferredYear) : ''; const list = $('#student-edit-disciplines'); list.replaceChildren(); const assigned = new Set<string>(student.discipline_slugs ?? []); availableDisciplines.forEach((discipline) => { const label = document.createElement('label'); label.className = 'flex items-center gap-2 rounded-xl border border-border-light p-3 text-sm dark:border-border-dark'; const checkbox = document.createElement('input'); checkbox.type = 'checkbox'; checkbox.value = discipline.slug; checkbox.checked = assigned.has(discipline.slug); checkbox.className = 'accent-accent-light'; label.append(checkbox, document.createTextNode(discipline.name)); list.append(label); }); $('#student-edit-dialog').showModal(); }
  function editDiscipline(item: Row) { const form = $('#discipline-form') as HTMLFormElement; for (const key of ['id','name','slug','description','sort_order'] as const) (form.elements.namedItem(key) as HTMLInputElement).value = String(item[key] ?? ''); (form.elements.namedItem('skills') as HTMLTextAreaElement).value = (item.skills ?? []).join('\n'); (form.elements.namedItem('competencies') as HTMLTextAreaElement).value = (item.competencies ?? []).join('\n'); (form.elements.namedItem('active') as HTMLInputElement).checked = item.active; $('#discipline-dialog').showModal(); }
  function editModule(item: Row) { const form = $('#module-form') as HTMLFormElement; for (const key of ['id','name','slug','sort_order','discipline_slug'] as const) (form.elements.namedItem(key) as HTMLInputElement).value = String(item[key] ?? ''); $('#module-dialog').showModal(); }
  function editLesson(item: Row) { const form = $('#lesson-form') as HTMLFormElement; for (const key of ['id','title','slug','summary','lesson_order','discipline_slug','module_id','reading_minutes','difficulty','key_idea'] as const) (form.elements.namedItem(key) as HTMLInputElement).value = String(item[key] ?? ''); const shortcuts = Array.isArray(item.shortcuts) && item.shortcuts.length ? item.shortcuts : (item.shortcut_keys ? [{ keys: item.shortcut_keys, label: item.shortcut_label }] : []); (form.elements.namedItem('shortcuts_text') as HTMLTextAreaElement).value = shortcuts.map((shortcut: any) => `${shortcut.keys} | ${shortcut.label}`).join('\n'); (form.elements.namedItem('tags') as HTMLInputElement).value = (item.tags ?? []).join(', '); (form.elements.namedItem('published') as HTMLInputElement).checked = item.published; (form.elements.namedItem('body_markdown') as HTMLTextAreaElement).value = item.body_markdown ?? ''; (form.elements.namedItem('practice_markdown') as HTMLTextAreaElement).value = item.practice_markdown ?? ''; (form.elements.namedItem('essential_points') as HTMLTextAreaElement).value = (item.essential_points ?? []).map((point: any) => `${point.title ?? ''} | ${point.description ?? ''}`).join('\n'); updateModuleOptions(); $('#lesson-dialog').showModal(); }
  function updateLessonSelection() { $('#lesson-selection-count').textContent = String(selectedLessonIds.size); const button = $('#lesson-bulk-delete') as HTMLButtonElement; button.disabled = selectedLessonIds.size === 0; if (!selectedLessonIds.size) $('#lesson-bulk-status').textContent = 'Selecione capítulos ou todos os resultados filtrados.'; }
  async function removeRow(kind: string, item: Row, refresh: () => Promise<void>) { if (!confirm(`Excluir “${item.name ?? item.title}”?`)) return; try { await api(`/api/admin/${kind}`, 'DELETE', { id: item.id }); if (kind === 'apostilas') { selectedLessonIds.delete(item.id); updateLessonSelection(); } await refresh(); } catch (error) { alert(error instanceof Error ? error.message : 'Erro ao excluir.'); } }
  function updateModuleOptions() { const discipline = ($('#lesson-form [name="discipline_slug"]') as HTMLSelectElement).value; const select = $('#lesson-form [name="module_id"]') as HTMLSelectElement; fillSelect(select, modules.filter((item) => item.discipline_slug === discipline), (item) => item.name, (item) => item.id, 'Sem módulo'); }
