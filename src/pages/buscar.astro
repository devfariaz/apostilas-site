---
import BaseLayout from '../layouts/BaseLayout.astro';
import { createSupabaseServerClient } from '../lib/supabase';
export const prerender = false;
const q = (Astro.url.searchParams.get('q') ?? '').trim().slice(0, 120);
const tag = (Astro.url.searchParams.get('tag') ?? '').trim().slice(0, 80);
let user = null;
let results: any[] = [];
let databaseReady = false;
try {
  const supabase = createSupabaseServerClient(Astro.cookies, Astro.request);
  const { data: auth } = await supabase.auth.getUser(); user = auth.user;
  if (user) {
    const { data, error } = await supabase.from('apostilas').select('slug,title,discipline_slug,module,summary,tags,body_markdown').eq('published', true).order('title').limit(500);
    if (!error) {
      databaseReady = true;
      const normalizedTag = tag.toLocaleLowerCase('pt-BR');
      const normalizedQuery = q.toLocaleLowerCase('pt-BR');
      results = (data ?? []).filter((lesson) => {
        const tags = Array.isArray(lesson.tags) ? lesson.tags : [];
        const matchesTag = !normalizedTag || tags.some((item: string) => item.toLocaleLowerCase('pt-BR') === normalizedTag);
        const searchable = [lesson.title, lesson.summary, lesson.module, ...tags, lesson.body_markdown].join(' ').toLocaleLowerCase('pt-BR');
        return matchesTag && (!normalizedQuery || searchable.includes(normalizedQuery));
      });
    }
  }
} catch { /* A busca oferece instrução de acesso quando o banco ainda não está configurado. */ }
---
<BaseLayout title="Buscar — Professor Deivid Nobre - Apostilas" description="Pesquise capítulos por assunto e tags." user={user}>
  <main class="mx-auto max-w-5xl px-5 py-12 lg:px-8">
    <p class="text-xs font-bold uppercase tracking-[.2em] text-accent-light">Biblioteca de estudos</p>
    <h1 class="mt-3 font-display text-4xl font-semibold md:text-5xl">Encontre um assunto</h1>
    <form action="/buscar" method="get" class="mt-7 flex gap-2 rounded-2xl border border-border-light bg-surface-light p-2 dark:border-border-dark dark:bg-surface-dark">
      <input name="q" value={q} class="min-w-0 flex-1 bg-transparent px-3 py-2 outline-none" placeholder="Ex.: vetores, Illustrator, composição" aria-label="Termo de busca" />
      {tag && <input type="hidden" name="tag" value={tag} />}
      <button class="rounded-xl bg-accent-light px-5 py-2 font-semibold text-white">Buscar</button>
    </form>
    {tag && <p class="mt-4 text-sm">Filtrando pela tag <a class="rounded-full bg-black/5 px-3 py-1 font-semibold text-accent-light dark:bg-white/10" href={`/buscar?q=${encodeURIComponent(q)}`}>#{tag} ×</a></p>}
    {!user ? <p class="mt-8 rounded-2xl border border-border-light p-6 dark:border-border-dark">Entre na sua conta para pesquisar nos capítulos das disciplinas atribuídas. <a class="font-semibold text-accent-light" href={`/login?next=${encodeURIComponent('/buscar')}`}>Fazer login →</a></p> : !databaseReady ? <p class="mt-8 rounded-2xl border border-border-light p-6 dark:border-border-dark">Não foi possível carregar a biblioteca agora. Tente novamente em instantes.</p> : <>
      <p class="mt-6 text-sm text-text-muted-light dark:text-text-muted-dark">{q || tag ? `${results.length} capítulo(s) encontrado(s)` : 'Digite um assunto ou escolha uma tag em um capítulo.'}</p>
      <div class="mt-4 grid gap-3">{results.map((lesson) => <article class="rounded-2xl border border-border-light bg-surface-light p-5 dark:border-border-dark dark:bg-surface-dark">
        <a href={`/apostila/${lesson.discipline_slug}#${encodeURIComponent(lesson.slug)}`} class="font-display text-xl font-semibold hover:text-accent-light">{lesson.title}</a>
        <p class="mt-1 text-xs font-semibold uppercase tracking-wider text-accent-light">{lesson.module || lesson.discipline_slug}</p>
        <p class="mt-2 text-sm leading-relaxed text-text-muted-light dark:text-text-muted-dark">{lesson.summary}</p>
        <div class="mt-3 flex flex-wrap gap-2">{(lesson.tags ?? []).map((item: string) => <a href={`/buscar?tag=${encodeURIComponent(item)}`} class="rounded-full bg-black/5 px-3 py-1 text-xs hover:bg-accent-light hover:text-white dark:bg-white/10">#{item}</a>)}</div>
      </article>)}</div>
      {q && results.length === 0 && <p class="mt-8 rounded-2xl border border-dashed border-border-light p-8 text-center text-text-muted-light dark:border-border-dark dark:text-text-muted-dark">Nenhum capítulo corresponde a essa busca nas disciplinas disponíveis para sua conta.</p>}
    </>}
  </main>
</BaseLayout>
