---
import ThemeToggle from './ThemeToggle.astro';
import LogoMark from './LogoMark.astro';
import { disciplines } from '../lib/catalog';
import { createSupabaseServerClient } from '../lib/supabase';
const { user } = Astro.props;
const displayName = user?.user_metadata?.full_name || user?.email || 'Conta';
const userInitials = String(displayName).split(/\s+/).slice(0, 2).map((part: string) => part[0]?.toLocaleUpperCase('pt-BR')).join('');
let subjects: { slug: string; name: string; description?: string | null }[] = [...disciplines];
let isAdmin = false;
let hasSession = Boolean(user);
try {
  const client = createSupabaseServerClient(Astro.cookies, Astro.request);
  const { data: { user: sessionUser } } = await client.auth.getUser();
  hasSession = Boolean(sessionUser);
  const result = await client.from('disciplines').select('slug,name,description').eq('active', true).order('sort_order').order('name');
  if (result.data?.length) subjects = result.data;
  if (sessionUser) {
    const profile = await client.from('profiles').select('role').eq('id', sessionUser.id).maybeSingle();
    isAdmin = profile.data?.role === 'admin';
    if (!isAdmin) {
      const assignments = await client.from('student_disciplines').select('discipline_slug').eq('user_id', sessionUser.id);
      const assignedSlugs = new Set((assignments.data ?? []).map((row) => row.discipline_slug));
      subjects = subjects.filter((item) => assignedSlugs.has(item.slug));
    }
  }
} catch { if (hasSession) subjects = []; /* Visitantes mantêm navegação pública; alunos dependem das atribuições retornadas pelo Supabase. */ }
const yearGroups = [
  { label: '1º ano', subjects: subjects.filter((item) => /(?:^|[-\s])i$/i.test(item.slug) || /\bI$/i.test(item.name)) },
  { label: '2º ano', subjects: subjects.filter((item) => /(?:^|[-\s])ii$/i.test(item.slug) || /\bII$/i.test(item.name)) },
  { label: '3º ano', subjects: subjects.filter((item) => /(?:^|[-\s])iii$/i.test(item.slug) || /\bIII$/i.test(item.name) || /marketing/i.test(item.name)) },
];
---
<header class="site-header sticky top-0 z-30 border-b border-border-light bg-bg-light/90 backdrop-blur dark:border-border-dark dark:bg-bg-dark/90">
  <div class="header-main mx-auto flex max-w-[1440px] items-center gap-2 px-3 py-2.5 sm:gap-3 sm:px-5 lg:px-8">
    <button id="mobile-menu-toggle" class="mobile-menu-toggle grid h-10 w-10 shrink-0 place-items-center rounded-xl border border-border-light text-text-main-light transition hover:bg-black/5 lg:hidden dark:border-border-dark dark:text-text-main-dark dark:hover:bg-white/10" type="button" aria-label="Abrir menu de disciplinas" aria-controls="mobile-year-nav" aria-expanded="false">
      <span class="hamburger-icon" aria-hidden="true"><i></i><i></i><i></i></span>
    </button>
    <a href="/" class="brand-link flex shrink-0 items-center gap-2 font-display tracking-tight" aria-label="Professor Deivid Nobre - Apostilas"><span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-accent-light"><LogoMark class="h-9 w-9 text-white" /></span><span class="brand-name flex flex-col text-sm font-bold leading-tight sm:text-base">Professor Deivid Nobre<span class="text-xs font-medium text-text-muted-light dark:text-text-muted-dark">Apostilas</span></span></a>
    <nav class="year-nav desktop-year-nav hidden min-w-0 flex-1 items-center gap-1 text-sm text-text-muted-light lg:flex dark:text-text-muted-dark" aria-label="Disciplinas por ano">
      {yearGroups.map((group) => group.subjects.length > 0 && <details class="year-nav-group relative">
        <summary class="flex cursor-pointer list-none items-center gap-2 rounded-full px-3 py-2 font-semibold transition hover:bg-black/5 hover:text-accent-light dark:hover:bg-white/10">{group.label}<span class="year-nav-chevron" aria-hidden="true">⌄</span></summary>
        <div class="year-nav-menu absolute left-0 top-full z-40 mt-2 min-w-60 rounded-2xl border border-border-light bg-surface-light p-2 shadow-xl dark:border-border-dark dark:bg-surface-dark">
          {group.subjects.map((item) => <a class="block rounded-xl px-3 py-2.5 transition hover:bg-black/5 hover:text-accent-light dark:hover:bg-white/10" href={`/apostila/${item.slug}`}><span class="block font-semibold text-text-main-light dark:text-text-main-dark">{item.name}</span>{item.description && <span class="mt-0.5 block text-xs text-text-muted-light dark:text-text-muted-dark">{item.description}</span>}</a>)}
        </div>
      </details>)}
    </nav>
    <div class="header-tools ml-auto flex min-w-0 items-center gap-1.5 sm:gap-2"><form action="/buscar" method="get" class="hidden w-56 shrink items-center gap-2 rounded-full border border-border-light bg-surface-light px-3 py-2.5 transition focus-within:border-accent-light focus-within:ring-2 focus-within:ring-accent-light/15 md:flex xl:w-96 dark:border-border-dark dark:bg-surface-dark"><span aria-hidden="true" class="text-lg leading-none text-text-muted-light">⌕</span><input aria-label="Buscar apostilas por assunto ou tag" name="q" class="min-w-0 flex-1 bg-transparent text-sm outline-none placeholder:text-text-muted-light" placeholder="Buscar na apostila" /><kbd class="rounded border border-border-light px-1.5 text-[10px] text-text-muted-light dark:border-border-dark dark:text-text-muted-dark">↵</kbd></form><a href="/buscar" class="search-shortcut rounded-full p-2 text-sm hover:bg-black/5 md:hidden dark:hover:bg-white/10" aria-label="Buscar">⌕</a><ThemeToggle />
      {user ? <details class="profile-menu relative"><summary aria-label={displayName} class="flex max-w-40 cursor-pointer list-none items-center gap-2 rounded-full p-1.5 text-sm hover:bg-black/5 dark:hover:bg-white/10"><span class="profile-initials grid h-8 w-8 shrink-0 place-items-center rounded-full bg-accent-light text-xs font-bold text-white sm:hidden">{userInitials}</span><span class="hidden max-w-32 truncate px-2 sm:inline">{displayName}</span></summary><div class="absolute right-0 mt-2 w-52 rounded-2xl border border-border-light bg-surface-light p-3 shadow-xl dark:border-border-dark dark:bg-surface-dark"><p class="truncate px-2 py-1 text-xs text-text-muted-light dark:text-text-muted-dark">{user.email}</p>{isAdmin && <a href="/admin" class="block rounded-xl px-2 py-2 text-sm hover:bg-black/5 dark:hover:bg-white/10">Painel administrativo</a>}<form action="/api/auth/logout" method="post"><button class="mt-2 w-full rounded-xl px-2 py-2 text-left text-sm hover:bg-black/5 dark:hover:bg-white/10">Sair da conta</button></form></div></details> : <a class="rounded-full bg-accent-light px-3 py-2 text-sm font-semibold text-white hover:opacity-90 sm:px-4" href="/login">Entrar</a>}
    </div>
  </div>
  <nav id="mobile-year-nav" class="year-nav mobile-year-nav mx-auto hidden max-w-[1440px] flex-col gap-2 px-3 pb-3 text-sm text-text-muted-light sm:px-5 lg:hidden dark:text-text-muted-dark" aria-label="Disciplinas por ano" hidden>
    {yearGroups.map((group) => group.subjects.length > 0 && <details class="year-nav-group relative">
      <summary class="flex cursor-pointer list-none items-center justify-between rounded-xl border border-border-light bg-surface-light px-4 py-3 font-semibold transition hover:border-accent-light dark:border-border-dark dark:bg-surface-dark">{group.label}<span class="year-nav-chevron" aria-hidden="true">⌄</span></summary>
      <div class="year-nav-menu mt-1 rounded-xl border border-border-light bg-surface-light p-1 text-sm dark:border-border-dark dark:bg-surface-dark">
        {group.subjects.map((item) => <a class="block rounded-xl px-3 py-2.5 transition hover:bg-black/5 hover:text-accent-light dark:hover:bg-white/10" href={`/apostila/${item.slug}`}><span class="block font-semibold text-text-main-light dark:text-text-main-dark">{item.name}</span>{item.description && <span class="mt-0.5 block text-xs text-text-muted-light dark:text-text-muted-dark">{item.description}</span>}</a>)}
      </div>
    </details>)}
  </nav>
</header>

<script>
  const yearMenus = [...document.querySelectorAll<HTMLDetailsElement>('.year-nav-group')];
  const mobileMenu = document.querySelector<HTMLElement>('#mobile-year-nav');
  const mobileMenuToggle = document.querySelector<HTMLButtonElement>('#mobile-menu-toggle');
  const setMobileMenuOpen = (open: boolean) => {
    if (!mobileMenu || !mobileMenuToggle) return;
    mobileMenu.hidden = !open;
    mobileMenu.classList.toggle('hidden', !open);
    mobileMenuToggle.setAttribute('aria-expanded', String(open));
    mobileMenuToggle.setAttribute('aria-label', open ? 'Fechar menu de disciplinas' : 'Abrir menu de disciplinas');
    if (!open) yearMenus.filter((menu) => mobileMenu.contains(menu)).forEach((menu) => { menu.open = false; });
  };
  mobileMenuToggle?.addEventListener('click', () => setMobileMenuOpen(mobileMenuToggle.getAttribute('aria-expanded') !== 'true'));
  mobileMenu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMobileMenuOpen(false)));
  document.addEventListener('click', (event) => {
    if (mobileMenu?.hidden) return;
    if (event.target instanceof Node && !mobileMenu?.contains(event.target) && !mobileMenuToggle?.contains(event.target)) setMobileMenuOpen(false);
  });
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape') setMobileMenuOpen(false); });
  yearMenus.forEach((menu) => menu.addEventListener('toggle', () => {
    if (!menu.open) return;
    yearMenus.forEach((otherMenu) => {
      if (otherMenu !== menu) otherMenu.open = false;
    });
  }));
</script>

<style>
  .header-main { min-height:64px; }
  .brand-link { text-align:left; }
  .hamburger-icon { display:flex; width:18px; flex-direction:column; gap:4px; }
  .hamburger-icon i { display:block; height:2px; border-radius:2px; background:currentColor; }
  .mobile-year-nav:not([hidden]) { display:flex; }
  .mobile-year-nav .year-nav-menu { position:static; min-width:0; box-shadow:none; }
  .year-nav-group > summary::-webkit-details-marker { display:none; }
  .year-nav-chevron { font-size:11px; transition:transform .18s; }
  .year-nav-group[open] .year-nav-chevron { transform:rotate(180deg); }
  .year-nav-menu { animation:year-menu-in .14s ease-out; }
  @keyframes year-menu-in { from { opacity:0; transform:translateY(-4px); } to { opacity:1; transform:translateY(0); } }
  @media (max-width:640px) { .header-main { gap:8px; padding-inline:10px; } .header-tools { gap:2px; } .brand-name { font-size:12px; } }
  @media (max-width:360px) { .brand-name { display:none; } }
  @media (min-width:1024px) { .mobile-year-nav { display:none; } }
</style>
